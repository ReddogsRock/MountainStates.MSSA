@using MountainStates.MSSA.Module.MSSA_Dogs.Services
@using MountainStates.MSSA.Module.MSSA_Dogs.Models
@using MountainStates.MSSA.Module.MSSA_Dogs.Enums
@using Oqtane.Modules.Controls

@namespace MountainStates.MSSA.Module.MSSA_Dogs
@inherits ModuleBase
@inject IMSSA_DogService DogService

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>Futurity Roster</h2>
            <p class="text-muted mb-0">
                Every dog nominated for Futurity, regardless of whether they've run or scored yet.
                For the points leaderboard instead (approved, scored results only), see Year End Standings.
            </p>
        </div>
        <div class="col-auto">
            <ActionLink Action="Index" Text="Back to Dogs" Class="btn btn-secondary" />
        </div>
    </div>

    @if (!UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
    {
        <div class="alert alert-warning">This report is only available to Administrators.</div>
    }
    else
    {
        <div class="row mb-3">
            <div class="col-md-3">
                <label for="yearFilter" class="form-label">Year</label>
                <select id="yearFilter" class="form-select" @bind="selectedYear" @bind:after="LoadRoster">
                    <option value="">All Years</option>
                    @foreach (var y in YearOptions)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
        </div>

        @if (entries == null)
        {
            <p><em>Loading...</em></p>
        }
        else if (!entries.Any())
        {
            <p class="text-muted"><em>No Futurity nominations found@(selectedYear.HasValue ? $" for {selectedYear}" : "").</em></p>
        }
        else
        {
            <p class="text-muted">@entries.Count nominated</p>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Year</th>
                            <th>Dog</th>
                            <th>Owner</th>
                            <th>Payment Status</th>
                            <th>Amount</th>
                            <th>Date Received</th>
                            <th>Documentation</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in entries)
                        {
                            <tr>
                                <td>@entry.Year</td>
                                <td>
                                    <ActionLink Action="Detail" Parameters="@($"id={entry.DogId}")" Text="@entry.DogName" ResourceKey="ViewDogName" />
                                </td>
                                <td>@(entry.OwnerName ?? "-")</td>
                                <td>
                                    @if (entry.Status == FuturityPaymentStatus.Paid)
                                    {
                                        <span class="badge bg-success">Paid</span>
                                    }
                                    else if (entry.Status == FuturityPaymentStatus.Failed)
                                    {
                                        <span class="badge bg-danger">Failed - Retry Needed</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Pending Payment</span>
                                    }
                                </td>
                                <td>@(entry.Amount?.ToString("C") ?? "-")</td>
                                <td>@(entry.DateReceived?.ToString("MMM dd, yyyy") ?? "-")</td>
                                <td>@(entry.HasDocument ? "Yes" : "No")</td>
                                <td>
                                    @if (entry.Status != FuturityPaymentStatus.Paid)
                                    {
                                        <button type="button" class="btn btn-sm btn-success me-1" @onclick="() => ShowMarkPaid(entry)">
                                            Mark Paid
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => MarkFailed(entry)">
                                            Mark Failed
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @* Mark Paid Modal *@
    @if (showMarkPaidModal && markPaidEntry != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Mark Paid</h5>
                        <button type="button" class="btn-close" @onclick="CloseMarkPaid"></button>
                    </div>
                    <div class="modal-body">
                        <p><strong>@markPaidEntry.DogName</strong> &mdash; @markPaidEntry.Year Futurity</p>
                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label">Amount</label>
                                <input type="number" step="0.01" class="form-control" @bind="markPaidAmount" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Paid By</label>
                                <select class="form-select" @bind="markPaidMethod">
                                    <option value="">Select...</option>
                                    <option value="Cash">Cash</option>
                                    <option value="Check">Check</option>
                                    <option value="PayPal">PayPal</option>
                                    <option value="Credit Card">Credit Card</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Date Received</label>
                                <input type="date" class="form-control"
                                       value="@markPaidDateReceived.ToString("yyyy-MM-dd")"
                                       @onchange="@(e => markPaidDateReceived = DateTime.Parse(e.Value.ToString()))" />
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(markPaidError))
                        {
                            <div class="alert alert-danger mt-3 mb-0">@markPaidError</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" @onclick="ConfirmMarkPaid">Confirm</button>
                        <button type="button" class="btn btn-secondary" @onclick="CloseMarkPaid">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<FuturityRosterEntry> entries;
    private int? selectedYear;

    private bool showMarkPaidModal = false;
    private FuturityRosterEntry markPaidEntry;
    private decimal? markPaidAmount;
    private string markPaidMethod = "";
    private DateTime markPaidDateReceived = DateTime.Today;
    private string markPaidError = "";

    // Competition year runs May 1 - Apr 30, named for the year it ends in - same rule
    // used for Futurity enrollment elsewhere (see Dogs/Edit.razor).
    private int CurrentCompetitionYear =>
        DateTime.Now.Month >= 5 ? DateTime.Now.Year + 1 : DateTime.Now.Year;

    // A handful of years around the current one - enough to cover recent/upcoming
    // nominations without listing every year back to 1900.
    private IEnumerable<int> YearOptions =>
        Enumerable.Range(CurrentCompetitionYear - 3, 6).OrderByDescending(y => y);

    protected override async Task OnInitializedAsync()
    {
        if (!UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
        {
            return;
        }

        selectedYear = CurrentCompetitionYear;
        await LoadRoster();
    }

    private async Task LoadRoster()
    {
        try
        {
            entries = await DogService.GetFuturityRosterAsync(selectedYear, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error loading futurity roster");
            AddModuleMessage("Error loading the Futurity roster", MessageType.Error);
        }
    }

    private void ShowMarkPaid(FuturityRosterEntry entry)
    {
        markPaidEntry = entry;
        markPaidAmount = entry.Amount;
        markPaidMethod = "";
        markPaidDateReceived = DateTime.Today;
        markPaidError = "";
        showMarkPaidModal = true;
    }

    private async Task ConfirmMarkPaid()
    {
        try
        {
            if (!markPaidAmount.HasValue || markPaidAmount.Value <= 0)
            {
                markPaidError = "Amount is required.";
                return;
            }
            if (string.IsNullOrWhiteSpace(markPaidMethod))
            {
                markPaidError = "Paid By is required.";
                return;
            }

            markPaidError = "";

            await DogService.MarkFuturityPaymentManualAsync(new MarkFuturityPaymentManualDto
            {
                ParticipationId = markPaidEntry.ParticipationId,
                Amount = markPaidAmount.Value,
                PaymentMethod = markPaidMethod,
                DateReceived = markPaidDateReceived
            }, ModuleState.ModuleId);

            CloseMarkPaid();
            await LoadRoster();
            AddModuleMessage("Futurity nomination marked as paid", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error marking futurity nomination paid");
            markPaidError = "Error saving. Please try again.";
        }
    }

    private void CloseMarkPaid()
    {
        showMarkPaidModal = false;
        markPaidEntry = null;
        markPaidAmount = null;
        markPaidMethod = "";
    }

    private async Task MarkFailed(FuturityRosterEntry entry)
    {
        try
        {
            await DogService.MarkFuturityPaymentFailedAsync(entry.ParticipationId, ModuleState.ModuleId);
            await LoadRoster();
            AddModuleMessage($"{entry.DogName}'s {entry.Year} nomination marked Failed - they can retry payment from the dog's Detail page", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error marking futurity nomination failed");
            AddModuleMessage("Error marking as failed. Please try again.", MessageType.Error);
        }
    }
}
