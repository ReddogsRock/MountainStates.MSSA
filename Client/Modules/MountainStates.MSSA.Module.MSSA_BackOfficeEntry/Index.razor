@using MountainStates.MSSA.Module.TrialSecretary.Models
@using Oqtane.Modules.Controls
@using MountainStates.MSSA.Module.BackOfficeEntry.Services
@using MountainStates.MSSA.Module.BackOfficeEntry.Models
@using MountainStates.MSSA.Module.MSSA_Handlers.Models
@using MountainStates.MSSA.Module.MSSA_Dogs.Models

@namespace MountainStates.MSSA.Module.BackOfficeEntry
@inherits ModuleBase
@inject IBackOfficeEntryService BackOfficeEntryService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Index> Localizer

<div class="container-fluid">
    <h3>Back Office — Trial Results Entry</h3>

    @if (_isLoading)
    {
        <div class="text-center my-5">
            <div class="spinner-border" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <p class="mt-2">Loading recent events...</p>
        </div>
    }
    else if (_errorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible">
            <strong>Error:</strong> @_errorMessage
            <button type="button" class="close" @onclick="@(() => _errorMessage = null)">
                <span>&times;</span>
            </button>
        </div>
    }

    @if (!_isLoading)
    {
        <!-- ═══════════════════════════════════════════════════
             STEP 1  —  EVENT / TRIAL / CLASS
             ═══════════════════════════════════════════════════ -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">1. Select Event / Trial / Class</h5>
            </div>
            <div class="card-body">
                @if (_recentEvents.Count == 0)
                {
                    <div class="alert alert-warning">No events found within the last 60 days.</div>
                }
                else
                {
                    <div class="row">
                        <!-- Event -->
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="eventSelect"><strong>Event:</strong></label>
                                <select id="eventSelect" class="form-control" @onchange="OnEventSelected">
                                    <option value="">-- Select Event --</option>
                                    @foreach (var evt in _recentEvents)
                                    {
                                        <option value="@evt.EventId" selected="@(_selectedEvent?.EventId == evt.EventId)">
                                            @evt.EventName — @evt.DateRange
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Trial -->
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="trialSelect"><strong>Trial:</strong></label>
                                <select id="trialSelect" class="form-control"
                                        disabled="@(_selectedEvent == null)"
                                        @onchange="OnTrialSelected">
                                    <option value="">-- Select Trial --</option>
                                    @if (_selectedEvent != null)
                                    {
                                        @foreach (var trial in _selectedEvent.Trials)
                                        {
                                            <option value="@trial.TrialId" selected="@(_selectedTrial?.TrialId == trial.TrialId)">
                                                @trial.TrialName (@trial.Stock)
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- Class -->
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="classSelect"><strong>Class:</strong></label>
                                <select id="classSelect" class="form-control"
                                        disabled="@(_selectedTrial == null)"
                                        @onchange="OnClassSelected">
                                    <option value="">-- Select Class --</option>
                                    @if (_selectedTrial != null)
                                    {
                                        @foreach (var cls in _selectedTrial.AvailableClasses)
                                        {
                                            <option value="@cls.ClassId" selected="@(_selectedClassId == cls.ClassId)">
                                                @cls.DisplayName
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    @if (_selectedEvent != null && _selectedTrial != null && _selectedClassId > 0)
                    {
                        <div class="alert alert-primary py-2 mb-0">
                            <strong>Context:</strong>
                            @_selectedEvent.EventName &nbsp;|&nbsp;
                            @_selectedTrial.TrialName (@_selectedTrial.Stock) &nbsp;|&nbsp;
                            @_selectedTrial.AvailableClasses.FirstOrDefault(c => c.ClassId == _selectedClassId)?.DisplayName
                        </div>
                    }
                }
            </div>
        </div>

        @if (ContextSelected)
        {
            <!-- ═══════════════════════════════════════════════════
                 STEP 2  —  HANDLER
                 ═══════════════════════════════════════════════════ -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">2. Select Handler</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="handlerId">Handler ID:</label>
                                <input id="handlerId" type="number" class="form-control"
                                       @bind="_handlerIdInput" placeholder="Enter Handler ID" />
                                <button class="btn btn-sm btn-outline-primary mt-1" @onclick="SearchHandlerById">
                                    Find by ID
                                </button>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">
                                <label for="handlerSearch">Search by Name:</label>
                                <div class="input-group">
                                    <input id="handlerSearch" type="text" class="form-control"
                                           @bind="_handlerSearchTerm" placeholder="Enter handler name..."
                                           @onkeyup="OnHandlerSearchKeyUp" />
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-primary" @onclick="SearchHandlers">Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (_handlerSearchResults.Count > 0)
                    {
                        <div class="mt-2">
                            <label>Search Results:</label>
                            <div class="list-group">
                                @foreach (var handler in _handlerSearchResults)
                                {
                                    <button type="button" class="list-group-item list-group-item-action"
                                            @onclick="@(() => SelectHandler(handler))">
                                        <strong>@handler.FullName</strong> (ID: @handler.HandlerId)
                                        <br />
                                        <small>@handler.City, @handler.StateCode</small>
                                        @if (handler.HasActiveMembership)
                                        {
                                            <span class="badge badge-success float-right">MSSA Member</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (_selectedHandler != null)
                    {
                        <div class="alert alert-success mt-3">
                            <strong>Selected Handler:</strong> @_selectedHandler.FullName (ID: @_selectedHandler.HandlerId)
                            <br />
                            @_selectedHandler.City, @_selectedHandler.StateCode
                            @if (_selectedHandler.HasActiveMembership)
                            {
                                <span class="badge badge-success ml-2">MSSA Member</span>
                            }
                            <button class="btn btn-sm btn-outline-secondary float-right" @onclick="ClearHandler">Clear</button>
                        </div>
                    }

                    <div class="mt-3">
                        <button class="btn btn-sm btn-outline-success" @onclick="ToggleAddHandler">
                            @(_showAddHandler ? "Cancel" : "Add New Handler")
                        </button>
                    </div>

                    @if (_showAddHandler)
                    {
                        <div class="card mt-2">
                            <div class="card-body">
                                <h6>Create New Handler</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>First Name: <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" @bind="_newHandler.FirstName" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Last Name: <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" @bind="_newHandler.LastName" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Email:</label>
                                            <input type="email" class="form-control" @bind="_newHandler.Email" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Phone:</label>
                                            <input type="tel" class="form-control" @bind="_newHandler.Phone" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="form-group">
                                            <label>City:</label>
                                            <input type="text" class="form-control" @bind="_newHandler.City" />
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label>State:</label>
                                            <input type="text" class="form-control" maxlength="2" @bind="_newHandler.StateCode" />
                                        </div>
                                    </div>
                                </div>
                                <button class="btn btn-success" @onclick="CreateNewHandler">Create Handler</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ═══════════════════════════════════════════════════
                 STEP 3  —  DOG
                 ═══════════════════════════════════════════════════ -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">3. Select Dog</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label for="dogId">Dog ID:</label>
                                <input id="dogId" type="number" class="form-control"
                                       @bind="_dogIdInput" placeholder="Enter Dog ID" />
                                <button class="btn btn-sm btn-outline-primary mt-1" @onclick="SearchDogById">
                                    Find by ID
                                </button>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group">
                                <label for="dogSearch">Search by Name:</label>
                                <div class="input-group">
                                    <input id="dogSearch" type="text" class="form-control"
                                           @bind="_dogSearchTerm" placeholder="Enter dog name..."
                                           @onkeyup="OnDogSearchKeyUp" />
                                    <div class="input-group-append">
                                        <button class="btn btn-outline-primary" @onclick="SearchDogs">Search</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (_dogSearchResults.Count > 0)
                    {
                        <div class="mt-2">
                            <label>Search Results:</label>
                            <div class="list-group">
                                @foreach (var dog in _dogSearchResults)
                                {
                                    <button type="button" class="list-group-item list-group-item-action"
                                            @onclick="@(() => SelectDog(dog))">
                                        <strong>@dog.Name</strong> (ID: @dog.DogId)
                                        <br />
                                        <small>@dog.DisplayInfo</small>
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (_selectedDog != null)
                    {
                        <div class="alert alert-info mt-3">
                            <strong>Selected Dog:</strong> @_selectedDog.Name (ID: @_selectedDog.DogId)
                            @if (!string.IsNullOrWhiteSpace(_selectedDog.Breed))
                            {
                                <span class="ml-2">— @_selectedDog.Breed</span>
                            }
                            <button class="btn btn-sm btn-outline-secondary float-right" @onclick="ClearDog">Clear</button>
                        </div>
                    }

                    <div class="mt-3">
                        <button class="btn btn-sm btn-outline-info" @onclick="ToggleAddDog">
                            @(_showAddDog ? "Cancel" : "Add New Dog")
                        </button>
                    </div>

                    @if (_showAddDog)
                    {
                        <div class="card mt-2">
                            <div class="card-body">
                                <h6>Create New Dog</h6>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Dog Name: <span class="text-danger">*</span></label>
                                            <input type="text" class="form-control" @bind="_newDog.Name" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label>Breed:</label>
                                            <input type="text" class="form-control" @bind="_newDog.Breed" />
                                        </div>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Owner Name:</label>
                                    <input type="text" class="form-control" @bind="_newDog.OwnerName" />
                                </div>
                                <button class="btn btn-info" @onclick="CreateNewDog">Create Dog</button>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ═══════════════════════════════════════════════════
                 STEP 4  —  SCORES
                 ═══════════════════════════════════════════════════ -->
            <div class="card mb-4">
                <div class="card-header @(_editingEntryId.HasValue ? "bg-warning" : "bg-secondary text-white")">
                    <h5 class="mb-0">
                        @if (_editingEntryId.HasValue)
                        {
                            <span>4. Edit Scores — Entry #@_editingEntryId</span>
                        }
                        else
                        {
                            <span>4. Enter Scores</span>
                        }
                    </h5>
                </div>
                <div class="card-body">
                    @if (_saveMessage != null)
                    {
                        <div class="alert @(_saveSuccess ? "alert-success" : "alert-danger") alert-dismissible">
                            @_saveMessage
                            <button type="button" class="close" @onclick="@(() => _saveMessage = null)">
                                <span>&times;</span>
                            </button>
                        </div>
                    }

                    <!-- Timing Row -->
                    <div class="row mb-3">
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Run Time <small class="text-muted">(digits only, e.g. 345 = 3:45)</small></label>
                                <input type="text" class="form-control" placeholder="e.g. 345"
                                       @bind="_currentEntry.RunTimeStr" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Tie Breaker Time <small class="text-muted">(digits only, e.g. 130 = 1:30)</small></label>
                                <input type="text" class="form-control" placeholder="e.g. 130"
                                       @bind="_currentEntry.TieBreakerTimeStr" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="form-group">
                                <label>Penalty</label>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.Penalty" placeholder="0" />
                            </div>
                        </div>
                    </div>

                    <!-- Obstacle Scores Grid -->
                    <label><strong>Obstacle Scores</strong></label>
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Obs 1</span>
                                </div>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.ObstacleScore1" placeholder="—" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Obs 2</span>
                                </div>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.ObstacleScore2" placeholder="—" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Obs 3</span>
                                </div>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.ObstacleScore3" placeholder="—" />
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Obs 4</span>
                                </div>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.ObstacleScore4" placeholder="—" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Obs 5</span>
                                </div>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.ObstacleScore5" placeholder="—" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Obs 6</span>
                                </div>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.ObstacleScore6" placeholder="—" />
                            </div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Obs 7</span>
                                </div>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.ObstacleScore7" placeholder="—" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Obs 8</span>
                                </div>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.ObstacleScore8" placeholder="—" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group mb-2">
                                <div class="input-group-prepend">
                                    <span class="input-group-text">Obs 9</span>
                                </div>
                                <input type="number" step="0.5" class="form-control"
                                       @bind="_currentEntry.ObstacleScore9" placeholder="—" />
                            </div>
                        </div>
                    </div>

                    <!-- Comments -->
                    <div class="form-group">
                        <label>Comments (optional):</label>
                        <input type="text" class="form-control" @bind="_currentEntry.Comments"
                               placeholder="Any notes about this run" />
                    </div>

                    <!-- Summary & Buttons -->
                    <div class="row align-items-center mt-3">
                        <div class="col-md-6">
                            <p class="mb-0 text-muted">
                                <strong>Handler:</strong> @(_selectedHandler?.FullName ?? "—")
                                &nbsp;|&nbsp;
                                <strong>Dog:</strong> @(_selectedDog?.Name ?? "—")
                            </p>
                        </div>
                        <div class="col-md-6 text-right">
                            @if (_editingEntryId.HasValue)
                            {
                                <button class="btn btn-outline-secondary mr-2" @onclick="CancelEdit">Cancel Edit</button>
                                <button class="btn btn-warning" @onclick="SaveEntry"
                                        disabled="@(!CanSaveEntry)">
                                    <i class="oi oi-pencil"></i> Update Entry
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary btn-lg" @onclick="SaveEntry"
                                        disabled="@(!CanSaveEntry)">
                                    <i class="oi oi-check"></i> Save Entry
                                </button>
                            }
                        </div>
                    </div>

                    @if (!CanSaveEntry)
                    {
                        <div class="text-muted mt-2">
                            <small>Please select a handler and dog before saving.</small>
                        </div>
                    }
                </div>
            </div>

            <!-- ═══════════════════════════════════════════════════
                 ENTRIES LIST  —  Current Trial / Class
                 ═══════════════════════════════════════════════════ -->
            <div class="card mb-4">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        Results for @_selectedTrial?.TrialName —
                        @(_selectedTrial?.AvailableClasses.FirstOrDefault(c => c.ClassId == _selectedClassId)?.DisplayName)
                        <span class="badge badge-light ml-2">@_classEntries.Count entries</span>
                    </h5>

                    @if (_classEntries.Count > 0 && !_classEntries.All(e => e.IsFinalized))
                    {
                        <button class="btn btn-success" @onclick="FinalizeClass"
                                disabled="@_isFinalizing">
                            @if (_isFinalizing)
                            {
                                <span class="spinner-border spinner-border-sm mr-1" role="status"></span>
                            }
                            <i class="oi oi-flag"></i> Finalize &amp; Calculate Placings
                        </button>
                    }
                    else if (_classEntries.Any() && _classEntries.All(e => e.IsFinalized))
                    {
                        <span class="badge badge-success">✔ Finalized</span>
                    }
                </div>
                <div class="card-body p-0">
                    @if (_classEntries.Count == 0)
                    {
                        <div class="alert alert-info m-3">No entries yet for this trial/class combination.</div>
                    }
                    else
                    {
                        @if (_finalizeMessage != null)
                        {
                            <div class="alert @(_finalizeSuccess ? "alert-success" : "alert-danger") m-3 alert-dismissible">
                                @_finalizeMessage
                                <button type="button" class="close" @onclick="@(() => _finalizeMessage = null)">
                                    <span>&times;</span>
                                </button>
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-sm table-striped table-bordered mb-0">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Place</th>
                                        <th>Handler</th>
                                        <th>Dog</th>
                                        <th>Time</th>
                                        <th>Tie Time</th>
                                        <th>Obs 1</th>
                                        <th>Obs 2</th>
                                        <th>Obs 3</th>
                                        <th>Obs 4</th>
                                        <th>Obs 5</th>
                                        <th>Obs 6</th>
                                        <th>Obs 7</th>
                                        <th>Obs 8</th>
                                        <th>Obs 9</th>
                                        <th>Penalty</th>
                                        <th>Total</th>
                                        <th>Pts</th>
                                        <th>Mbr</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in _classEntries.OrderBy(e => e.Placing ?? 9999).ThenBy(e => e.EntryId))
                                    {
                                        <tr class="@(entry.EntryId == _editingEntryId ? "table-warning" : "")">
                                            <td>
                                                @if (entry.IsFinalized)
                                                {
                                                    <strong>@entry.Placing</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>@entry.HandlerName</td>
                                            <td>@entry.DogName</td>
                                            <td>@entry.RunTimeDisplay</td>
                                            <td>@entry.TieBreakerTimeDisplay</td>
                                            <td>@(entry.ObstacleScore1?.ToString("0.#") ?? "—")</td>
                                            <td>@(entry.ObstacleScore2?.ToString("0.#") ?? "—")</td>
                                            <td>@(entry.ObstacleScore3?.ToString("0.#") ?? "—")</td>
                                            <td>@(entry.ObstacleScore4?.ToString("0.#") ?? "—")</td>
                                            <td>@(entry.ObstacleScore5?.ToString("0.#") ?? "—")</td>
                                            <td>@(entry.ObstacleScore6?.ToString("0.#") ?? "—")</td>
                                            <td>@(entry.ObstacleScore7?.ToString("0.#") ?? "—")</td>
                                            <td>@(entry.ObstacleScore8?.ToString("0.#") ?? "—")</td>
                                            <td>@(entry.ObstacleScore9?.ToString("0.#") ?? "—")</td>
                                            <td>@(entry.Penalty?.ToString("0.#") ?? "—")</td>
                                            <td><strong>@(entry.TotalScore?.ToString("0.#") ?? "—")</strong></td>
                                            <td>
                                                @if (entry.IsFinalized)
                                                {
                                                    <strong>@entry.TrialPoints</strong>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                            <td>
                                                @if (entry.HandlerIsMSSAMember)
                                                {
                                                    <span class="badge badge-success">✔</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-secondary">—</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-xs btn-outline-warning"
                                                        @onclick="@(() => EditEntry(entry))">
                                                    Edit
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _isLoading = true;
    private string _errorMessage;
    private string _saveMessage;
    private bool _saveSuccess;
    private string _finalizeMessage;
    private bool _finalizeSuccess;
    private bool _isFinalizing;

    // Context (sticky — preserved between entries)
    private List<RecentEventDto> _recentEvents = new List<RecentEventDto>();
    private RecentEventDto _selectedEvent;
    private TrialSummaryDto _selectedTrial;
    private int _selectedClassId;

    // Handler selection
    private string _handlerSearchTerm = "";
    private int? _handlerIdInput;
    private List<HandlerSearchDto> _handlerSearchResults = new List<HandlerSearchDto>();
    private HandlerSearchDto _selectedHandler;
    private bool _showAddHandler;
    private CreateHandlerDto _newHandler = new CreateHandlerDto();

    // Dog selection
    private string _dogSearchTerm = "";
    private int? _dogIdInput;
    private List<DogSearchDto> _dogSearchResults = new List<DogSearchDto>();
    private DogSearchDto _selectedDog;
    private bool _showAddDog;
    private CreateDogDto _newDog = new CreateDogDto();

    // Score form (current entry being entered / edited)
    private SaveResultEntryDto _currentEntry = new SaveResultEntryDto();
    private int? _editingEntryId;   // null = new entry, non-null = editing existing

    // Entries list for current Trial/Class
    private List<ResultEntryListItem> _classEntries = new List<ResultEntryListItem>();

    private bool ContextSelected =>
        _selectedEvent != null && _selectedTrial != null && _selectedClassId > 0;

    private bool CanSaveEntry =>
        ContextSelected && _selectedHandler != null && _selectedDog != null;

    // ─────────────────────────────────────────────────────────
    //  Lifecycle
    // ─────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _recentEvents = await BackOfficeEntryService.GetRecentEventsWithTrialsAsync(ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load events: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    // ─────────────────────────────────────────────────────────
    //  Context Selection
    // ─────────────────────────────────────────────────────────

    private async Task OnEventSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int eventId) && eventId > 0)
        {
            _selectedEvent = _recentEvents.FirstOrDefault(ev => ev.EventId == eventId);
        }
        else
        {
            _selectedEvent = null;
        }
        _selectedTrial = null;
        _selectedClassId = 0;
        _classEntries.Clear();
        ResetEntryForm();
    }

    private async Task OnTrialSelected(ChangeEventArgs e)
    {
        if (_selectedEvent != null && int.TryParse(e.Value?.ToString(), out int trialId) && trialId > 0)
        {
            _selectedTrial = _selectedEvent.Trials.FirstOrDefault(t => t.TrialId == trialId);
        }
        else
        {
            _selectedTrial = null;
        }
        _selectedClassId = 0;
        _classEntries.Clear();
        ResetEntryForm();
    }

    private async Task OnClassSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int classId) && classId > 0)
        {
            _selectedClassId = classId;
            await RefreshEntriesList();
        }
        else
        {
            _selectedClassId = 0;
            _classEntries.Clear();
        }
        ResetEntryForm();
    }

    private async Task RefreshEntriesList()
    {
        if (_selectedTrial == null || _selectedClassId == 0) return;
        try
        {
            _classEntries = await BackOfficeEntryService.GetTrialClassEntriesAsync(
                _selectedTrial.TrialId, _selectedClassId, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load entries: {ex.Message}";
        }
    }

    // ─────────────────────────────────────────────────────────
    //  Handler
    // ─────────────────────────────────────────────────────────

    private async Task OnHandlerSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchHandlers();
    }

    private async Task SearchHandlers()
    {
        try { _handlerSearchResults = await BackOfficeEntryService.SearchHandlersAsync(_handlerSearchTerm, ModuleState.ModuleId); }
        catch (Exception ex) { _errorMessage = $"Handler search failed: {ex.Message}"; }
    }

    private async Task SearchHandlerById()
    {
        if (!_handlerIdInput.HasValue || _handlerIdInput.Value <= 0) return;
        try
        {
            var h = await BackOfficeEntryService.GetHandlerByIdAsync(_handlerIdInput.Value, ModuleState.ModuleId);
            if (h != null) SelectHandler(h);
            else _errorMessage = $"Handler ID {_handlerIdInput.Value} not found.";
        }
        catch (Exception ex) { _errorMessage = $"Handler lookup failed: {ex.Message}"; }
    }

    private void SelectHandler(HandlerSearchDto handler)
    {
        _selectedHandler = handler;
        _handlerSearchResults.Clear();
        _handlerSearchTerm = "";
        _handlerIdInput = null;
        _showAddHandler = false;
    }

    private void ClearHandler() { _selectedHandler = null; }

    private void ToggleAddHandler()
    {
        _showAddHandler = !_showAddHandler;
        if (_showAddHandler) _newHandler = new CreateHandlerDto();
    }

    private async Task CreateNewHandler()
    {
        if (string.IsNullOrWhiteSpace(_newHandler.FirstName) || string.IsNullOrWhiteSpace(_newHandler.LastName))
        {
            _errorMessage = "First and last name are required.";
            return;
        }
        try
        {
            var h = await BackOfficeEntryService.CreateHandlerAsync(_newHandler, ModuleState.ModuleId);
            SelectHandler(new HandlerSearchDto
            {
                HandlerId = h.HandlerId, FullName = h.FullName,
                City = h.City, StateCode = h.StateCode,
                Email = h.Email, Phone = h.Phone
            });
            _newHandler = new CreateHandlerDto();
        }
        catch (Exception ex) { _errorMessage = $"Failed to create handler: {ex.Message}"; }
    }

    // ─────────────────────────────────────────────────────────
    //  Dog
    // ─────────────────────────────────────────────────────────

    private async Task OnDogSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchDogs();
    }

    private async Task SearchDogs()
    {
        try { _dogSearchResults = await BackOfficeEntryService.SearchDogsAsync(_dogSearchTerm, ModuleState.ModuleId); }
        catch (Exception ex) { _errorMessage = $"Dog search failed: {ex.Message}"; }
    }

    private async Task SearchDogById()
    {
        if (!_dogIdInput.HasValue || _dogIdInput.Value <= 0) return;
        try
        {
            var d = await BackOfficeEntryService.GetDogByIdAsync(_dogIdInput.Value, ModuleState.ModuleId);
            if (d != null) SelectDog(d);
            else _errorMessage = $"Dog ID {_dogIdInput.Value} not found.";
        }
        catch (Exception ex) { _errorMessage = $"Dog lookup failed: {ex.Message}"; }
    }

    private void SelectDog(DogSearchDto dog)
    {
        _selectedDog = dog;
        _dogSearchResults.Clear();
        _dogSearchTerm = "";
        _dogIdInput = null;
        _showAddDog = false;
    }

    private void ClearDog() { _selectedDog = null; }

    private void ToggleAddDog()
    {
        _showAddDog = !_showAddDog;
        if (_showAddDog) _newDog = new CreateDogDto();
    }

    private async Task CreateNewDog()
    {
        if (string.IsNullOrWhiteSpace(_newDog.Name))
        {
            _errorMessage = "Dog name is required.";
            return;
        }
        try
        {
            var d = await BackOfficeEntryService.CreateDogAsync(_newDog, ModuleState.ModuleId);
            SelectDog(new DogSearchDto { DogId = d.DogId, Name = d.Name, Breed = d.Breed, OwnerName = d.OwnerName });
            _newDog = new CreateDogDto();
        }
        catch (Exception ex) { _errorMessage = $"Failed to create dog: {ex.Message}"; }
    }

    // ─────────────────────────────────────────────────────────
    //  Save / Edit Entry
    // ─────────────────────────────────────────────────────────

    private async Task SaveEntry()
    {
        if (!CanSaveEntry) return;

        // Parse time strings
        _currentEntry.RunTimeStr = _currentEntry.RunTimeStr?.Trim();
        _currentEntry.TieBreakerTimeStr = _currentEntry.TieBreakerTimeStr?.Trim();
        _currentEntry.TrialId = _selectedTrial.TrialId;
        _currentEntry.ClassId = _selectedClassId;
        _currentEntry.HandlerId = _selectedHandler.HandlerId;
        _currentEntry.DogId = _selectedDog.DogId;
        _currentEntry.EntryId = _editingEntryId ?? 0;

        try
        {
            await BackOfficeEntryService.SaveResultEntryAsync(_currentEntry, ModuleState.ModuleId);

            _saveSuccess = true;
            _saveMessage = _editingEntryId.HasValue
                ? $"Entry updated successfully."
                : $"Entry saved for {_selectedHandler.FullName} / {_selectedDog.Name}.";

            // Reset handler, dog, and scores — keep Event/Trial/Class
            ResetEntryForm();

            // Refresh the list
            await RefreshEntriesList();
        }
        catch (Exception ex)
        {
            _saveSuccess = false;
            _saveMessage = $"Failed to save entry: {ex.Message}";
        }
    }

    private async Task EditEntry(ResultEntryListItem item)
    {
        // Load the full DTO for editing
        try
        {
            var dto = await BackOfficeEntryService.GetResultEntryAsync(item.EntryId, ModuleState.ModuleId);
            if (dto == null) { _errorMessage = "Could not load entry for editing."; return; }

            _editingEntryId = item.EntryId;
            _currentEntry = dto;
            _currentEntry.EntryId = item.EntryId;

            // Time strings come back pre-formatted from the server (already strings in DTO)

            // Load handler and dog for the form display
            var handler = await BackOfficeEntryService.GetHandlerByIdAsync(dto.HandlerId, ModuleState.ModuleId);
            if (handler != null) _selectedHandler = handler;

            var dog = await BackOfficeEntryService.GetDogByIdAsync(dto.DogId, ModuleState.ModuleId);
            if (dog != null) _selectedDog = dog;

            _saveMessage = null;
        }
        catch (Exception ex) { _errorMessage = $"Failed to load entry: {ex.Message}"; }
    }

    private void CancelEdit() => ResetEntryForm();

    // ─────────────────────────────────────────────────────────
    //  Finalize
    // ─────────────────────────────────────────────────────────

    private async Task FinalizeClass()
    {
        _isFinalizing = true;
        _finalizeMessage = null;
        try
        {
            var result = await BackOfficeEntryService.FinalizeTrialClassAsync(
                _selectedTrial.TrialId, _selectedClassId, ModuleState.ModuleId);

            _finalizeSuccess = true;
            _finalizeMessage = result.Message;
            await RefreshEntriesList();
        }
        catch (Exception ex)
        {
            _finalizeSuccess = false;
            _finalizeMessage = $"Finalize failed: {ex.Message}";
        }
        finally
        {
            _isFinalizing = false;
        }
    }

    // ─────────────────────────────────────────────────────────
    //  Helpers
    // ─────────────────────────────────────────────────────────

    /// <summary>
    /// Resets handler, dog, and all score fields. Does NOT touch Event/Trial/Class.
    /// </summary>
    private void ResetEntryForm()
    {
        _selectedHandler = null;
        _selectedDog = null;
        _handlerSearchResults.Clear();
        _dogSearchResults.Clear();
        _handlerSearchTerm = "";
        _dogSearchTerm = "";
        _currentEntry = new SaveResultEntryDto();
        _editingEntryId = null;
        _showAddHandler = false;
        _showAddDog = false;
    }

}
