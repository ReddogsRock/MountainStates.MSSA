@using Oqtane.Modules
@using Oqtane.Services
@using Oqtane.Shared
@namespace MountainStates.MSSA.Module.MSSA_Events
@inherits ModuleBase
@inject ISettingService SettingService
@inject NavigationManager NavigationManager

<div class="container">
    <div class="row mb-3">
        <div class="col-sm-9 offset-sm-3 form-check">
            <input type="checkbox" class="form-check-input" id="limitToRecent" @bind="@_limitToRecent" />
            <label class="form-check-label" for="limitToRecent">Only show recent &amp; upcoming events</label>
        </div>
    </div>
    <div class="row mb-3">
        <label class="col-sm-3">Days in the Past to Include:</label>
        <div class="col-sm-9">
            <input type="number" class="form-control" @bind="@_daysInPast" min="0" disabled="@(!_limitToRecent)" />
            <div class="form-text">Events that started more than this many days ago are hidden. Upcoming events always show.</div>
        </div>
    </div>
    <div class="row mb-3">
        <label class="col-sm-3">Event Order:</label>
        <div class="col-sm-9">
            <select class="form-select" @bind="@_sortDescending">
                <option value="true">Farthest out first (newest to oldest)</option>
                <option value="false">Soonest first (oldest to newest)</option>
            </select>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-sm-9 offset-sm-3">
            <button type="button" class="btn btn-primary" @onclick="SaveSettings">Save</button>
            <button type="button" class="btn btn-secondary" @onclick="Cancel">Cancel</button>
        </div>
    </div>
</div>

@code {
    public override SecurityAccessLevel SecurityAccessLevel => SecurityAccessLevel.Edit;

    private bool _limitToRecent = false;
    private int _daysInPast = 7;
    // Bound as a string, not a bool - Blazor's @bind on a <select> formats a bool as
    // "True"/"False" (capitalized), which never matches these lowercase option values,
    // so the selection couldn't round-trip. String-bound to match the same workaround
    // already used for this in ContainerSettings.razor and MSSA_Dogs/Index.razor.
    // Default (true = farthest out first) matches the order this list has always shown,
    // so existing module instances that never set this keep behaving the same way.
    private string _sortDescending = "true";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _limitToRecent = bool.Parse(SettingService.GetSetting(ModuleState.Settings, "LimitToRecent", "false"));
            _daysInPast = int.Parse(SettingService.GetSetting(ModuleState.Settings, "DaysInPast", "7"));
            _sortDescending = SettingService.GetSetting(ModuleState.Settings, "SortDescending", "true");
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error loading settings");
        }
    }

    private async Task SaveSettings()
    {
        try
        {
            var settings = await SettingService.GetModuleSettingsAsync(ModuleState.ModuleId);
            SettingService.SetSetting(settings, "LimitToRecent", _limitToRecent.ToString());
            SettingService.SetSetting(settings, "DaysInPast", _daysInPast.ToString());
            SettingService.SetSetting(settings, "SortDescending", _sortDescending);
            await SettingService.UpdateModuleSettingsAsync(settings, ModuleState.ModuleId);

            NavigationManager.NavigateTo(NavigateUrl());
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error saving settings");
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo(NavigateUrl());
    }
}
