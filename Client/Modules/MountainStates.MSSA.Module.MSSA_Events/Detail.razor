@using MountainStates.MSSA.Module.MSSA_Entries.Models
@using MountainStates.MSSA.Module.MSSA_Events.Services
@using MountainStates.MSSA.Module.MSSA_Events.Models
@using MountainStates.MSSA.Module.MSSA_Handlers.Enums
@using MountainStates.MSSA.Module.MSSA_Results.Services
@using Oqtane.Modules.Controls

@namespace MountainStates.MSSA.Module.MSSA_Events
@inherits ModuleBase
@inject IMSSA_EventService EventService
@inject IMSSA_ResultService ResultService
@inject NavigationManager NavigationManager

@if (evt == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col">
                <h2>@evt.EventName</h2>
                <p class="text-muted">@evt.EventIdentifier</p>
            </div>
            <div class="col-auto">
                <ActionLink Action="Index" Text="Back to List" ResourceKey="BackToList" Class="btn btn-secondary me-2" />
                @if (CanEdit())
                {
                    <ActionLink Action="Edit" Parameters="@($"id={evt.EventId}")"
                                Security="SecurityAccessLevel.Edit" Text="Edit"
                                ResourceKey="EditEvent" Class="btn btn-primary" />
                }
            </div>
        </div>

        @if (PageState.QueryString.ContainsKey("sanctionfee"))
        {
            @if (PageState.QueryString["sanctionfee"] == "success")
            {
                <div class="alert alert-success">
                    Payment received - thank you! The sanctioning fee will show as paid here
                    shortly once Stripe confirms the charge.
                </div>
            }
            else if (PageState.QueryString["sanctionfee"] == "cancelled")
            {
                <div class="alert alert-warning">
                    The sanctioning fee wasn't paid. Use the button below to try again.
                </div>
            }
        }

        @* Event Information *@
        <div class="card mb-3">
            <div class="card-header">
                <h4>Event Information</h4>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Dates:</dt>
                            <dd class="col-sm-8">@evt.DateRange</dd>

                            <dt class="col-sm-4">Trial Site:</dt>
                            <dd class="col-sm-8">@(evt.TrialSite ?? "Not specified")</dd>

                            <dt class="col-sm-4">Street Address:</dt>
                            <dd class="col-sm-8">@(evt.StreetAddress ?? "Not specified")</dd>

                            <dt class="col-sm-4">Location:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(evt.City))
                                {
                                    <text>@evt.City, @evt.StateCode</text>
                                    <a href="@GetMapUrl(evt)" target="_blank" rel="noopener" class="ms-2">View on Map</a>
                                }
                                else
                                {
                                    <em>Not specified</em>
                                }
                            </dd>

                            <dt class="col-sm-4">Point Year:</dt>
                            <dd class="col-sm-8">@(evt.PointYear?.ToString() ?? "N/A")</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-4">Trial Host:</dt>
                            <dd class="col-sm-8">@(evt.ChairmanName ?? "Not specified")</dd>

                            <dt class="col-sm-4">Trial Host Phone:</dt>
                            <dd class="col-sm-8">@(evt.ChairmanPhone ?? "Not provided")</dd>

                            <dt class="col-sm-4">Trial Host Email:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(evt.ChairmanEmail))
                                {
                                    <a href="mailto:@evt.ChairmanEmail">@evt.ChairmanEmail</a>
                                }
                                else
                                {
                                    <em>Not provided</em>
                                }
                            </dd>

                            <dt class="col-sm-4">Entry Link:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(evt.EntryLink))
                                {
                                    <a href="@evt.EntryLink" target="_blank" rel="noopener">Enter This Event</a>
                                }
                                else
                                {
                                    <em>Not provided</em>
                                }
                            </dd>

                            <dt class="col-sm-4">Flyer:</dt>
                            <dd class="col-sm-8">
                                @if (!string.IsNullOrEmpty(evt.FlyerFileName))
                                {
                                    <a href="@FlyerDownloadUrl" target="_blank" rel="noopener">@evt.FlyerFileName</a>
                                }
                                else
                                {
                                    <em>Not uploaded</em>
                                }
                            </dd>

                            <dt class="col-sm-4">MSSA Sanctioned:</dt>
                            <dd class="col-sm-8">
                                @if (evt.IsMSSASanctioned)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        @* Planning Information *@
        <div class="card mb-3">
            <div class="card-header">
                <h4>Planning Information</h4>
            </div>
            <div class="card-body">
                @if (evt.Offerings == null || !evt.Offerings.Any())
                {
                    <p class="text-muted"><em>No run offerings have been planned for this event yet.</em></p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Class</th>
                                <th>Stock</th>
                                <th>Venue</th>
                                <th>Planned Runs</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var offering in evt.Offerings)
                            {
                                <tr>
                                    <td>@offering.ClassName @offering.SubClassName</td>
                                    <td>@offering.Stock</td>
                                    <td>@offering.Venue</td>
                                    <td>@offering.PlannedRuns</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @if (evt.NumberOfRuns.HasValue)
                {
                    <div class="row mt-2">
                        <div class="col-12">
                            <strong>Number of Runs:</strong> @evt.NumberOfRuns
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(evt.Notes))
                {
                    <div class="row mt-2">
                        <div class="col-12">
                            <strong>Notes:</strong>
                            <p>@evt.Notes</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Administrative Information *@
        <div class="card mb-3">
            <div class="card-header">
                <h4>Administrative Information</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Results Received:</dt>
                    <dd class="col-sm-9">@(evt.ResultsReceivedDate?.ToString("MMM dd, yyyy") ?? "Not received")</dd>

                    <dt class="col-sm-3">Results Uploaded:</dt>
                    <dd class="col-sm-9">
                        @if (evt.ResultsUploaded)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </dd>
                    @if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
                    {
                    <dt class="col-sm-3">Sanction Fee:</dt>
                    <dd class="col-sm-9">@(evt.SanctionFee?.ToString("C") ?? "N/A")</dd>
                    }

                    <dt class="col-sm-3">Fee Received:</dt>
                    <dd class="col-sm-9">@(evt.FeeReceivedDate?.ToString("MMM dd, yyyy") ?? "Not received")</dd>
                </dl>

                @if (CanEdit())
                {
                    <hr />
                    <h5>Pay Sanctioning Fee</h5>
                    <p class="text-muted">
                        $5 per run - every scored run in this event, plus any unsanctioned runs
                        held (still insured, so still owed) that never went through the app.
                    </p>

                    @if (!string.IsNullOrEmpty(feeError))
                    {
                        <div class="alert alert-danger">@feeError</div>
                    }

                    <div class="row mb-2">
                        <label class="col-sm-3 col-form-label">Sanctioned Runs:</label>
                        <div class="col-sm-9 col-form-label">
                            @(sanctionedRunCount?.ToString() ?? "Loading...")
                        </div>
                    </div>
                    <div class="row mb-2">
                        <label for="unsanctionedRuns" class="col-sm-3 col-form-label">Unsanctioned Runs:</label>
                        <div class="col-sm-3">
                            <input id="unsanctionedRuns" type="number" min="0" class="form-control"
                                   @bind="unsanctionedRuns" />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label">Total Runs:</label>
                        <div class="col-sm-9 col-form-label">
                            <strong>@((sanctionedRunCount ?? 0) + unsanctionedRuns)</strong>
                        </div>
                    </div>

                    <button class="btn btn-primary" @onclick="PaySanctionFee"
                            disabled="@(payingFee || sanctionedRunCount == null || (sanctionedRunCount + unsanctionedRuns) <= 0)">
                        @(payingFee ? "Redirecting to Stripe..." : "Pay Sanctioning Fee")
                    </button>
                }
            </div>
        </div>

        @* Team (only visible/manageable by the creator) *@
        @if (IsCreator())
        {
            <div class="card mb-3">
                <div class="card-header">
                    <h4>Team</h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Other Trial Secretaries added here get the same management access
                        to this event (trials, entries, submitting for approval) as you do.
                    </p>
                    @if (teamMembers != null && teamMembers.Any())
                    {
                        <ul class="list-group mb-3">
                            @foreach (var member in teamMembers)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    @member.DisplayName
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveTeamMember(member.UserId)">
                                        Remove
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p class="text-muted"><em>No teammates added yet.</em></p>
                    }
                    <div class="row g-2">
                        <div class="col-md-6">
                            <select class="form-select" @bind="selectedNewTeamMemberId">
                                <option value="">Select a Trial Secretary...</option>
                                @if (trialSecretaries != null)
                                {
                                    @foreach (var user in trialSecretaries.Where(u => u.UserId != evt.CreatedByUserId && (teamMembers == null || !teamMembers.Any(m => m.UserId == u.UserId))))
                                    {
                                        <option value="@user.UserId">@user.DisplayName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="button" class="btn btn-primary" disabled="@(!selectedNewTeamMemberId.HasValue)" @onclick="AddTeamMember">
                                Add to Team
                            </button>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(teamError))
                    {
                        <div class="alert alert-danger mt-2 mb-0">@teamError</div>
                    }
                </div>
            </div>
        }

        @* Trials with Expandable Entries *@
        <div class="card">
            <div class="card-header">
                <h4>Trials (@evt.TrialCount)</h4>
            </div>
            <div class="card-body">
                @if (trials == null)
                {
                    <p><em>Loading trials...</em></p>
                }
                else if (!trials.Any())
                {
                    <p><em>No trials scheduled for this event.</em></p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Trial Name</th>
                                <th>Identifier</th>
                                <th>Stock</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trial in trials)
                            {
                                <tr>
                                    <td>@trial.TrialDate.ToString("MMM dd, yyyy")</td>
                                    <td>@trial.TrialName</td>
                                    <td><small class="text-muted">@trial.TrialIdentifier</small></td>
                                    <td>@trial.Stock</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary" @onclick="() => ToggleTrialEntries(trial.TrialId)">
                                            @(_expandedTrialId == trial.TrialId ? "Hide" : "View")
                                        </button>
                                    </td>
                                </tr>
                                
                                @* Expandable Entries Section *@
                                @if (_expandedTrialId == trial.TrialId)
                                {
                                    <tr>
                                        <td colspan="5" class="p-0">
                                            <div class="trial-entries-section p-3 bg-light">
                                                @if (_loadingEntries)
                                                {
                                                    <p><em>Loading entries...</em></p>
                                                }
                                                else if (_currentTrialEntries != null)
                                                {
                                                    @* Class Filter *@
                                                    <div class="row mb-3">
                                                        <div class="col-md-4">
                                                            <label for="classFilter" class="form-label fw-bold">Filter by Class:</label>
                                                            <select id="classFilter" class="form-select form-select-sm" 
                                                                    @bind="_selectedClass" @bind:after="ApplyFilter">
                                                                <option value="">All Classes</option>
                                                                @foreach (var className in _availableClasses)
                                                                {
                                                                    <option value="@className">@className</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <div class="col-md-8 d-flex align-items-end">
                                                            <small class="text-muted">
                                                                Showing @_filteredEntries?.Count of @_currentTrialEntries?.Count entries
                                                            </small>
                                                        </div>
                                                    </div>

                                                    @* Entries Table *@
                                                    @if (_filteredEntries != null && _filteredEntries.Any())
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-striped table-bordered table-sm">
                                                                <thead class="table-dark">
                                                                    <tr>
                                                                        <th>Class</th>
                                                                        <th>Placing</th>
                                                                        <th>Dog Name</th>
                                                                        <th>Handler Name</th>
                                                                        <th>Run Time</th>
                                                                        <th>Tiebreaker</th>
                                                                        <th>Obstacles</th>
                                                                        <th>Points</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var entry in _filteredEntries)
                                                                    {
                                                                        <tr>
                                                                            <td>
                                                                                @entry.ClassName
                                                                                @if (!string.IsNullOrEmpty(entry.SubClassName))
                                                                                {
                                                                                    <br /><small class="text-muted">@entry.SubClassName</small>
                                                                                }
                                                                            </td>
                                                                            <td class="text-center">
                                                                                @if (entry.Placing.HasValue)
                                                                                {
                                                                                    <span class="@GetPlacingBadgeClass(entry.Placing.Value)">
                                                                                        @entry.Placing.Value
                                                                                    </span>
                                                                                }
                                                                                else
                                                                                {
                                                                                    <span class="text-muted">-</span>
                                                                                }
                                                                            </td>
                                                                            <td>@entry.DogName</td>
                                                                            <td>@entry.HandlerName</td>
                                                                            <td class="text-end">@FormatTime(entry.RunTime)</td>
                                                                            <td class="text-end">@FormatTime(entry.TieBreakerTime)</td>
                                                                            <td class="text-end">@(entry.SumOfObstacles?.ToString("F1") ?? "-")</td>
                                                                            <td class="text-end">@(entry.TrialPoints?.ToString() ?? "-")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <p class="text-muted">No entries found for this trial.</p>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
}

<style>
    .trial-entries-section {
        border-left: 3px solid #0d6efd;
    }

    .placing-badge {
        display: inline-block;
        min-width: 2rem;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        font-weight: 600;
    }
</style>

@code {
    private MSSA_Event evt;
    private List<MSSA_Trial> trials;
    
    // Entry expansion state
    private int? _expandedTrialId = null;
    private List<EntryListItem> _currentTrialEntries;
    private List<EntryListItem> _filteredEntries;
    private List<string> _availableClasses = new();
    private string _selectedClass = "";

    // Uses the Street Address when it's been entered, for a precise venue pin;
    // otherwise falls back to City/State, which only points at the general area.
    private string GetMapUrl(MSSA_Event evt)
    {
        var address = string.IsNullOrEmpty(evt.StreetAddress)
            ? $"{evt.City}, {evt.StateCode}"
            : $"{evt.StreetAddress}, {evt.City}, {evt.StateCode}";
        var query = Uri.EscapeDataString(address);
        return $"https://www.google.com/maps/search/?api=1&query={query}";
    }
    private bool _loadingEntries = false;

    // Sanctioning fee
    private int? sanctionedRunCount;
    private int unsanctionedRuns = 0;
    private bool payingFee = false;
    private string feeError;

    private string FlyerDownloadUrl =>
        $"{PageState.Alias.BaseUrl}/api/MSSA_Event/{evt.EventId}/flyer?moduleid={ModuleState.ModuleId}";

    private List<UserOptionDto> teamMembers;
    private List<UserOptionDto> trialSecretaries;
    private int? selectedNewTeamMemberId;
    private string teamError = "";

    // Admins can edit any event; Trial Secretaries their own, or one they've been
    // added to as a team member.
    private bool CanEdit()
    {
        if (IsCreator())
        {
            return true;
        }

        return UserSecurity.IsAuthorized(PageState.User, MSSARoles.TrialSecretary)
            && teamMembers != null && teamMembers.Any(u => u.UserId == PageState.User.UserId);
    }

    // Only the event's own creator (or an Admin) manages the team roster - not the
    // teammates themselves, even once added.
    private bool IsCreator()
    {
        if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
        {
            return true;
        }

        return UserSecurity.IsAuthorized(PageState.User, MSSARoles.TrialSecretary)
            && evt.CreatedByUserId == PageState.User.UserId;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            int eventId = int.Parse(PageState.QueryString["id"]);
            evt = await EventService.GetEventAsync(eventId, ModuleState.ModuleId);
            trials = await EventService.GetEventTrialsAsync(eventId, ModuleState.ModuleId);
            teamMembers = await EventService.GetEventTeamAsync(eventId, PageState.Site.SiteId, ModuleState.ModuleId);

            if (IsCreator())
            {
                trialSecretaries = await EventService.GetTrialSecretariesAsync(PageState.Site.SiteId, ModuleState.ModuleId);
            }

            if (CanEdit())
            {
                sanctionedRunCount = await ResultService.GetScoredRunCountAsync(eventId, ModuleState.ModuleId);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error loading event details");
            AddModuleMessage("Error loading event details", MessageType.Error);
        }
    }

    private async Task AddTeamMember()
    {
        try
        {
            teamError = "";
            if (!selectedNewTeamMemberId.HasValue)
            {
                return;
            }

            await EventService.AddTeamMemberAsync(evt.EventId, selectedNewTeamMemberId.Value, ModuleState.ModuleId);
            teamMembers = await EventService.GetEventTeamAsync(evt.EventId, PageState.Site.SiteId, ModuleState.ModuleId);
            selectedNewTeamMemberId = null;
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error adding event team member");
            teamError = "Error adding team member. Please try again.";
        }
    }

    private async Task RemoveTeamMember(int userId)
    {
        try
        {
            teamError = "";
            await EventService.RemoveTeamMemberAsync(evt.EventId, userId, ModuleState.ModuleId);
            teamMembers = await EventService.GetEventTeamAsync(evt.EventId, PageState.Site.SiteId, ModuleState.ModuleId);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error removing event team member");
            teamError = "Error removing team member. Please try again.";
        }
    }

    private async Task PaySanctionFee()
    {
        try
        {
            feeError = null;

            if (evt.FeeReceivedDate.HasValue)
            {
                var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
                    $"A sanctioning fee was already received for this event on {evt.FeeReceivedDate:MMM dd, yyyy} ({evt.SanctionFee:C}). Pay again?");
                if (!confirmed)
                {
                    return;
                }
            }

            payingFee = true;

            // Stripe Checkout requires absolute URLs to redirect back to.
            var successUrl = NavigationManager.ToAbsoluteUri(EditUrl("Detail", $"id={evt.EventId}&sanctionfee=success")).ToString();
            var cancelUrl = NavigationManager.ToAbsoluteUri(EditUrl("Detail", $"id={evt.EventId}&sanctionfee=cancelled")).ToString();

            var checkout = await EventService.CreateSanctionFeeCheckoutAsync(
                evt.EventId,
                new CreateSanctionFeeCheckoutDto
                {
                    EventId = evt.EventId,
                    UnsanctionedRuns = unsanctionedRuns,
                    SuccessUrl = successUrl,
                    CancelUrl = cancelUrl
                },
                ModuleState.ModuleId);

            await logger.LogInformation("Redirecting to Stripe checkout for event {EventId} sanctioning fee", evt.EventId);
            await JSRuntime.InvokeVoidAsync("window.location.assign", checkout.CheckoutUrl);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error creating sanctioning fee checkout for event {EventId}", evt.EventId);
            feeError = "Error starting the payment. Please try again.";
            payingFee = false;
        }
    }

    private async Task ToggleTrialEntries(int trialId)
    {
        if (_expandedTrialId == trialId)
        {
            // Collapse if clicking same trial
            _expandedTrialId = null;
            _currentTrialEntries = null;
            _filteredEntries = null;
            _availableClasses.Clear();
            _selectedClass = "";
        }
        else
        {
            // Expand and load entries
            _expandedTrialId = trialId;
            _loadingEntries = true;
            _selectedClass = "";
            
            try
            {
                _currentTrialEntries = await EventService.GetTrialEntriesAsync(trialId, ModuleState.ModuleId);
                
                // Get unique classes
                _availableClasses = _currentTrialEntries
                    .Select(e => e.ClassName)
                    .Distinct()
                    .OrderBy(c => c)
                    .ToList();
                
                // Sort entries by Class, then Placing (complete first), then other fields
                ApplyFilter();
            }
            catch (Exception ex)
            {
                await logger.LogError(ex, "Error loading trial entries");
                AddModuleMessage("Error loading trial entries", MessageType.Error);
            }
            finally
            {
                _loadingEntries = false;
            }
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<EntryListItem> filtered;
        
        if (string.IsNullOrEmpty(_selectedClass))
        {
            filtered = _currentTrialEntries;
        }
        else
        {
            filtered = _currentTrialEntries.Where(e => e.ClassName == _selectedClass);
        }

        // Sort: Class, then Placing (nulls last), then Dog Name
        _filteredEntries = filtered
            .OrderBy(e => e.ClassName)
            .ThenBy(e => e.Placing.HasValue ? 0 : 1)  // Complete entries first
            .ThenBy(e => e.Placing ?? int.MaxValue)
            .ThenBy(e => e.DogName)
            .ToList();
    }

    private string FormatTime(TimeSpan? time)
    {
        if (!time.HasValue) return "-";

        return time.Value.ToString(@"mm\:ss");
    }

    private string GetPlacingBadgeClass(int placing)
    {
        return placing switch
        {
            1 => "badge bg-warning text-dark placing-badge",
            2 => "badge bg-secondary text-dark placing-badge",
            3 => "badge bg-danger placing-badge",
            _ => "badge bg-primary placing-badge"
        };
    }
}
