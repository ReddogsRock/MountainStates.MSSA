@using MountainStates.MSSA.Module.MSSA_Results.Services
@using MountainStates.MSSA.Module.MSSA_Results.Models
@using MountainStates.MSSA.Module.MSSA_Results.Enums
@using MountainStates.MSSA.Module.MSSA_Results.Utilities
@using MountainStates.MSSA.Module.MSSA_Entries.Enums
@using MountainStates.MSSA.Module.MSSA_Events.Services
@using MountainStates.MSSA.Module.MSSA_Events.Models
@using MountainStates.MSSA.Module.MSSA_Handlers.Enums
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Forms
@using System.IO

@namespace MountainStates.MSSA.Module.MSSA_Results
@inherits ModuleBase
@inject IMSSA_ResultService ResultService
@inject IMSSA_EventService EventService

<script suppress-error="BL9992">
    // Fetches a script and waits for it to finish loading, rather than relying on a
    // <script src> tag rendered by a Blazor component (not guaranteed to execute).
    // Safe to call more than once for the same URL.
    window.mssaResultsLoadScript = (src) => {
        if (document.querySelector(`script[src="${src}"]`)) {
            return Promise.resolve();
        }
        return new Promise((resolve, reject) => {
            const script = document.createElement('script');
            script.src = src;
            script.onload = () => resolve();
            script.onerror = () => reject(new Error('Failed to load ' + src));
            document.head.appendChild(script);
        });
    };

    // Fetches the org logo once and caches it as a data URL (jsPDF's addImage needs a
    // data URL or Image element, not a bare src) - every export after the first reuses
    // the cached copy instead of re-fetching. Own copy of the same helper in
    // Entries/Index.razor - a separate component's embedded <script> isn't guaranteed
    // to have run yet if that page hasn't been visited this session.
    window.mssaResultsGetLogoDataUrl = async (logoUrl) => {
        if (window.__mssaLogoDataUrl) {
            return window.__mssaLogoDataUrl;
        }
        try {
            const response = await fetch(logoUrl);
            const blob = await response.blob();
            window.__mssaLogoDataUrl = await new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = () => resolve(reader.result);
                reader.onerror = reject;
                reader.readAsDataURL(blob);
            });
            return window.__mssaLogoDataUrl;
        } catch (e) {
            return null; // missing/unreachable logo shouldn't block the export
        }
    };

    // One results sheet per Class, each its own gridlined table, under a shared
    // letterhead (logo, org name, Event, Trial, Date) - built for posting to social
    // media. tableHead is the column header row, so this same builder serves both the
    // per-run Export Results PDF and the per-competitor Weekend Average PDF.
    window.mssaExportResultsPdf = async (fileName, headerLines, sections, tableHead, logoUrl) => {
        if (!window.jspdf) {
            await window.mssaResultsLoadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js');
        }
        if (!window.jspdf.jsPDF.API.autoTable) {
            await window.mssaResultsLoadScript('https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.4/jspdf.plugin.autotable.min.js');
        }

        const logoDataUrl = await window.mssaResultsGetLogoDataUrl(logoUrl);

        const { jsPDF } = window.jspdf;
        const doc = new jsPDF();
        let y = 16;

        // Logo is 311x241 (~1.29:1) - sized to roughly match the header text block to
        // its right, not the tables further down the page.
        if (logoDataUrl) {
            doc.addImage(logoDataUrl, 'JPEG', 14, 10, 20, 15.5);
        }
        const textX = logoDataUrl ? 40 : 14;

        doc.setFontSize(14);
        doc.text(headerLines[0], textX, y);
        y += 8;

        doc.setFontSize(11);
        for (let i = 1; i < headerLines.length; i++) {
            doc.text(headerLines[i], textX, y);
            y += 6;
        }
        y = Math.max(y + 4, logoDataUrl ? 30 : 0);

        for (const section of sections) {
            if (y > 260) {
                doc.addPage();
                y = 16;
            }

            doc.setFontSize(12);
            doc.text(section.className, 14, y);
            y += 4;

            doc.autoTable({
                head: [tableHead],
                body: section.rows,
                startY: y,
                theme: 'grid',
                styles: { fontSize: 9, lineWidth: 0.1, lineColor: [0, 0, 0] },
                headStyles: { fillColor: [230, 230, 230], textColor: [0, 0, 0] },
                margin: { left: 14, right: 14 }
            });

            y = doc.lastAutoTable.finalY + 10;
        }

        doc.save(fileName);
    };
</script>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>Enter Results</h2>
        </div>
    </div>

    @if (isAdmin)
    {
        <div class="card mb-3 border-warning">
            <div class="card-header bg-warning">
                <h5 class="mb-0">Pending Approval</h5>
            </div>
            <div class="card-body">
                @if (pendingEvents == null)
                {
                    <p><em>Loading...</em></p>
                }
                else if (!pendingEvents.Any())
                {
                    <p class="text-muted mb-0"><em>Nothing waiting on approval.</em></p>
                }
                else
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Event</th>
                                <th>Dates</th>
                                <th>Runs Scored</th>
                                <th>Submitted</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evt in pendingEvents)
                            {
                                <tr>
                                    <td>@evt.EventName</td>
                                    <td>@evt.DateRange</td>
                                    <td>@evt.ScoredRuns / @evt.TotalRuns</td>
                                    <td>@(evt.ResultsSubmittedDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                                    <td>
                                        <button class="btn btn-sm btn-success" @onclick="() => ApproveEvent(evt.EventId)">
                                            Approve
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success">@successMessage</div>
    }

    <div class="row mb-3">
        <div class="col-md-6">
            <label for="eventSearch" class="form-label">Search Event</label>
            <input id="eventSearch" class="form-control mb-1" @bind="eventSearchTerm" @bind:event="oninput"
                   placeholder="Filter the list below by name" />
            <select id="eventSelect" class="form-select" @bind="selectedEventId" @bind:after="OnEventChanged">
                <option value="0">-- Select Event --</option>
                @foreach (var evt in FilteredEvents)
                {
                    <option value="@evt.EventId">@evt.EventName - @evt.DateRange (@evt.ScoredRuns/@evt.TotalRuns scored)</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label for="trialSelect" class="form-label">Select Trial</label>
            <select id="trialSelect" class="form-select" @bind="selectedTrialId" @bind:after="OnTrialChanged"
                    disabled="@(trials == null || !trials.Any())">
                <option value="0">-- Select Trial --</option>
                @if (trials != null)
                {
                    @foreach (var trial in trials)
                    {
                        <option value="@trial.TrialId">@trial.TrialDate.ToString("MMM dd, yyyy") - @trial.TrialName (@trial.Stock)</option>
                    }
                }
            </select>
        </div>
    </div>

    @if (selectedEvent != null)
    {
        <div class="card mb-3">
            <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <strong>@selectedEvent.ScoredRuns / @selectedEvent.TotalRuns</strong> runs scored
                    &nbsp;-&nbsp;
                    <span class="badge @StatusBadgeClass(selectedEvent.ResultsApprovalStatus)">
                        @StatusLabel(selectedEvent.ResultsApprovalStatus)
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary" @onclick="ExportWeekendCombinedPdf" disabled="@(selectedEvent.ScoredRuns == 0)">
                        Weekend Average
                    </button>
                    @if (selectedEvent.ResultsApprovalStatus != EventResultsStatus.Approved && canSubmitForApproval)
                    {
                        <button class="btn btn-primary" @onclick="SubmitForApproval">
                            Submit Event for Approval
                        </button>
                    }
                </div>
            </div>
        </div>
    }

    @if (selectedTrialId > 0)
    {
        <div class="row mb-2">
            <div class="col">
                <button class="btn btn-secondary btn-sm" @onclick="CalculatePlacingAndPoints" disabled="@(rows == null || !rows.Any())">
                    Calculate Placing &amp; Points
                </button>
                <button class="btn btn-outline-secondary btn-sm ms-2" @onclick="ExportResultsPdf" disabled="@(rows == null || !rows.Any())">
                    Export Results PDF
                </button>
                <br />
                <small class="text-muted">Calculate is optional - can be run any time, or left until every run is entered.</small>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col">
                <a class="btn btn-outline-secondary btn-sm" href="@ScoreSheetDownloadUrl" target="_blank">
                    Download Scoring Sheet
                </a>
                <label class="btn btn-outline-secondary btn-sm ms-2 mb-0">
                    Upload Completed Score Sheet
                    <InputFile OnChange="OnScoreSheetSelected" style="display:none" accept=".xlsx" />
                </label>
                <label class="btn btn-outline-secondary btn-sm ms-2 mb-0">
                    Import Complete Trial
                    <InputFile OnChange="OnCompleteTrialSelected" style="display:none" accept=".xlsx" />
                </label>
                <br />
                <small class="text-muted">
                    <strong>Upload Completed Score Sheet</strong> fills in scores on entries already in this trial -
                    works with our template, or your own spreadsheet, as long as it has HandlerId, DogId, and
                    ClassId columns (column order and extra columns don't matter).
                    <strong>Import Complete Trial</strong> is for a trial scored entirely in your own spreadsheet,
                    with no entries in the app yet - it creates the entries themselves. Needs a Class column
                    (name or ID) and a Handler and Dog column each (name or ID) - Handler/Dog names must already
                    exist in the system; unmatched rows are skipped and listed so you can add them and re-upload.
                </small>
            </div>
        </div>

        @if (importResult != null)
        {
            <div class="alert @(importResult.RowsUpdated > 0 ? "alert-success" : "alert-warning") mb-3">
                <div>Updated @importResult.RowsUpdated of @importResult.RowsProcessed row(s).</div>
                @if (importResult.Warnings.Any())
                {
                    <ul class="mb-0">
                        @foreach (var warning in importResult.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                }
            </div>
        }

        @if (completeTrialResult != null)
        {
            <div class="alert @(completeTrialResult.RowsCreated > 0 ? "alert-success" : "alert-warning") mb-3">
                <div>
                    Created @completeTrialResult.RowsCreated of @completeTrialResult.RowsProcessed row(s).
                    @if (completeTrialResult.RowsSkippedExisting > 0)
                    {
                        <text> @completeTrialResult.RowsSkippedExisting already existed.</text>
                    }
                    @if (completeTrialResult.RowsSkippedUnmatched > 0)
                    {
                        <text> @completeTrialResult.RowsSkippedUnmatched unmatched (see below).</text>
                    }
                </div>
                @if (completeTrialResult.ErrorsFile != null)
                {
                    <div class="mb-2">
                        <a class="btn btn-sm btn-outline-danger" href="@CompleteTrialErrorsFileUrl" download="UnmatchedRows.xlsx">
                            Download Unmatched Rows
                        </a>
                        <small class="text-muted d-block mt-1">
                            Fix the Handler/Dog spelling or ID in this file, then upload it back through
                            "Import Complete Trial" - already-imported rows are skipped, so only the fixed ones go in.
                        </small>
                    </div>
                }
                @if (completeTrialResult.Warnings.Any())
                {
                    <ul class="mb-0">
                        @foreach (var warning in completeTrialResult.Warnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                }
            </div>
        }

        @if (rows == null)
        {
            <p><em>Loading runs...</em></p>
        }
        else if (!rows.Any())
        {
            <p class="text-muted"><em>No runs found for this trial.</em></p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle">
                    <thead>
                        <tr>
                            <th style="width:60px">Run #</th>
                            <th>Class</th>
                            <th>Handler</th>
                            <th>Dog</th>
                            <th style="width:120px">Time</th>
                            <th style="width:120px">Tie Time</th>
                            <th style="width:120px">Total Points</th>
                            <th style="width:70px">Place</th>
                            <th style="width:70px">Points</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in rows)
                        {
                            <tr>
                                <td>@(row.RunOrder?.ToString() ?? "-")</td>
                                <td>@row.ClassName @row.SubClassName</td>
                                <td>@row.HandlerName</td>
                                <td>@row.DogName</td>
                                <td>
                                    <input class="form-control form-control-sm" placeholder="m:ss"
                                           value="@row.RunTimeStr"
                                           @oninput="e => { row.RunTimeStr = e.Value?.ToString(); MarkDirty(row); }"
                                           @onkeydown="@(e => OnRowKeyDown(e, row))"
                                           @onblur="() => SaveRow(row)" />
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" placeholder="m:ss"
                                           value="@row.TieBreakerTimeStr"
                                           @oninput="e => { row.TieBreakerTimeStr = e.Value?.ToString(); MarkDirty(row); }"
                                           @onkeydown="@(e => OnRowKeyDown(e, row))"
                                           @onblur="() => SaveRow(row)" />
                                </td>
                                <td>
                                    <input type="number" step="0.01" class="form-control form-control-sm"
                                           value="@row.TotalScore"
                                           @oninput="e => { row.TotalScore = decimal.TryParse(e.Value?.ToString(), out var v) ? v : (decimal?)null; MarkDirty(row); }"
                                           @onkeydown="@(e => OnRowKeyDown(e, row))"
                                           @onblur="() => SaveRow(row)" />
                                </td>
                                <td class="text-center">@(row.Placing?.ToString() ?? "-")</td>
                                <td class="text-center">@(row.TrialPoints?.ToString() ?? "-")</td>
                                <td class="text-center">
                                    @if (savedEntryIds.Contains(row.EntryId))
                                    {
                                        <span class="text-success" title="Saved">&#10003;</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@code {
    private bool isAdmin;
    private bool canSubmitForApproval;

    private List<EventScoringSummary> events;
    private List<EventScoringSummary> pendingEvents;
    private List<MSSA_Trial> trials;
    private List<ResultRunRow> rows;

    private string eventSearchTerm = "";

    private IEnumerable<EventScoringSummary> FilteredEvents
    {
        get
        {
            if (events == null) return Enumerable.Empty<EventScoringSummary>();
            if (string.IsNullOrWhiteSpace(eventSearchTerm)) return events;

            var term = eventSearchTerm.Trim();
            return events.Where(e => e.EventName != null && e.EventName.Contains(term, StringComparison.OrdinalIgnoreCase));
        }
    }

    private int selectedEventId = 0;
    private int selectedTrialId = 0;

    private string errorMessage = "";
    private string successMessage = "";

    private readonly HashSet<int> savedEntryIds = new();
    private ScoreSheetImportResult importResult;
    private ImportCompleteTrialResult completeTrialResult;

    private EventScoringSummary selectedEvent => events?.FirstOrDefault(e => e.EventId == selectedEventId);

    protected override async Task OnInitializedAsync()
    {
        isAdmin = UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin);
        // A Scorekeeper is assigned per Trial, not the Event, so submitting for approval
        // (an event-owner/sanctioning-fee decision) isn't theirs to make.
        canSubmitForApproval = isAdmin || UserSecurity.IsAuthorized(PageState.User, MSSARoles.TrialSecretary);

        try
        {
            events = await ResultService.GetScoringEventsAsync(ModuleState.ModuleId);

            if (isAdmin)
            {
                pendingEvents = await ResultService.GetPendingApprovalEventsAsync(ModuleState.ModuleId);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error loading results events");
            errorMessage = "Error loading events.";
        }
    }

    private async Task OnEventChanged()
    {
        errorMessage = "";
        successMessage = "";
        selectedTrialId = 0;
        rows = null;
        savedEntryIds.Clear();
        importResult = null;

        if (selectedEventId > 0)
        {
            var eventTrials = await EventService.GetEventTrialsAsync(selectedEventId, ModuleState.ModuleId);

            // A Scorekeeper (and not also Admin/Trial Secretary) can't act on a trial
            // they're not assigned to anyway - showing it here would just be a dead end,
            // so only their assigned trial(s) for this event appear.
            trials = canSubmitForApproval
                ? eventTrials
                : eventTrials.Where(t => t.ScorekeeperUserId == PageState.User.UserId).ToList();
        }
        else
        {
            trials = null;
        }
    }

    private async Task OnTrialChanged()
    {
        errorMessage = "";
        successMessage = "";
        savedEntryIds.Clear();
        importResult = null;

        if (selectedTrialId > 0)
        {
            var loaded = await ResultService.GetTrialRunRowsAsync(selectedTrialId, ModuleState.ModuleId);

            // A trial that's already been placed is more useful to review in
            // Class + Placing order; one that hasn't yet keeps run order, since that's
            // the order dogs are actually called into the ring.
            rows = loaded.Any(r => r.Placing.HasValue) ? SortByClassAndPlacing(loaded) : loaded;
        }
        else
        {
            rows = null;
        }
    }

    private static List<ResultRunRow> SortByClassAndPlacing(List<ResultRunRow> list)
    {
        return list
            .OrderBy(r => ClassRunOrder.IndexOf(r.ClassName))
            .ThenBy(r => r.ClassName)
            .ThenBy(r => r.SubClassName)
            .ThenBy(r => r.Placing ?? int.MaxValue)
            .ToList();
    }

    private void MarkDirty(ResultRunRow row)
    {
        savedEntryIds.Remove(row.EntryId);
    }

    // One-page-friendly results sheet, grouped by Class in the same fixed run-order
    // sequence, for a Trial Secretary to post to social media.
    private async Task ExportResultsPdf()
    {
        if (rows == null || !rows.Any())
        {
            return;
        }

        try
        {
            var trial = trials?.FirstOrDefault(t => t.TrialId == selectedTrialId);

            var headerLines = new[]
            {
                "MSSA - Mountain States Stockdog Association",
                selectedEvent?.EventName ?? "",
                trial?.TrialName ?? "",
                trial?.TrialDate.ToString("MMM dd, yyyy") ?? ""
            };

            var sections = rows
                .GroupBy(r => new { r.ClassName, r.SubClassName })
                .OrderBy(g => ClassRunOrder.IndexOf(g.Key.ClassName))
                .ThenBy(g => g.Key.ClassName)
                .ThenBy(g => g.Key.SubClassName)
                .Select(g => new
                {
                    className = $"{g.Key.ClassName} {g.Key.SubClassName}".Trim(),
                    rows = g
                        .OrderBy(r => r.Placing ?? int.MaxValue)
                        .Select(r => new[]
                        {
                            r.HandlerName,
                            r.DogName,
                            r.RunTimeStr ?? "",
                            r.TieBreakerTimeStr ?? "",
                            r.TotalScore?.ToString("F2") ?? "",
                            r.Placing?.ToString() ?? "",
                            r.TrialPoints?.ToString() ?? ""
                        })
                        .ToArray()
                })
                .ToArray();

            var fileName = $"Results_{trial?.TrialIdentifier ?? "Trial"}_{DateTime.Now:yyyyMMdd}.pdf";
            var tableHead = new[] { "Handler", "Dog", "Time", "Tie Time", "Total Points", "Place", "Points" };
            var logoUrl = $"{PageState.Alias.BaseUrl}/images/mssa-logo.jpg";

            await JSRuntime.InvokeVoidAsync("mssaExportResultsPdf", fileName, headerLines, sections, tableHead, logoUrl);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error exporting results PDF for trial {TrialId}", selectedTrialId);
            errorMessage = "Error creating the PDF. Please try again.";
        }
    }

    // Per-competitor combined total across every trial in the event, regardless of
    // Stock (a Cattle trial and a Sheep trial in the same Class both count toward the
    // same competitor's total) - not an actual average despite the label; "Weekend
    // Average" is just the name staff already use for this report. Grouped by Class,
    // ranked by run count first - someone who competed in every trial always outranks
    // someone who competed in fewer, regardless of points/time, since summed totals
    // otherwise unfairly favor fewer runs (less time added up, usually fewer points
    // too). Within the same run count, highest combined points, lowest combined time
    // as the tiebreaker (the same order individual-run placing uses).
    private async Task ExportWeekendCombinedPdf()
    {
        if (selectedEventId <= 0)
        {
            return;
        }

        try
        {
            var eventTrials = await EventService.GetEventTrialsAsync(selectedEventId, ModuleState.ModuleId);

            var allRows = new List<ResultRunRow>();
            foreach (var trial in eventTrials)
            {
                allRows.AddRange(await ResultService.GetTrialRunRowsAsync(trial.TrialId, ModuleState.ModuleId));
            }

            // TotalScore alone, not IsScored (which also requires RunTime) - older/
            // migrated trials were scored on points only, with no time ever recorded,
            // and those runs still belong in this report. A missing time just
            // contributes 0 to that competitor's time sum below.
            var scoredRows = allRows.Where(r => r.TotalScore.HasValue).ToList();
            if (!scoredRows.Any())
            {
                errorMessage = "No scored runs found for this event yet.";
                return;
            }

            var headerLines = new[]
            {
                "MSSA - Mountain States Stockdog Association",
                selectedEvent?.EventName ?? "",
                "Weekend Average",
                selectedEvent?.DateRange ?? ""
            };

            var sections = scoredRows
                .GroupBy(r => r.ClassName)
                .OrderBy(g => ClassRunOrder.IndexOf(g.Key))
                .ThenBy(g => g.Key)
                .Select(g => new
                {
                    className = g.Key,
                    rows = g
                        .GroupBy(r => new { r.HandlerName, r.DogName })
                        .Select(cg => new
                        {
                            cg.Key.HandlerName,
                            cg.Key.DogName,
                            TotalPoints = cg.Sum(r => r.TotalScore ?? 0),
                            TotalTime = cg.Aggregate(TimeSpan.Zero, (sum, r) => sum + (TimeParsingHelper.ParseMinutesSeconds(r.RunTimeStr) ?? TimeSpan.Zero)),
                            RunCount = cg.Count()
                        })
                        .OrderByDescending(c => c.RunCount)
                        .ThenByDescending(c => c.TotalPoints)
                        .ThenBy(c => c.TotalTime)
                        .Select(c => new[]
                        {
                            c.HandlerName,
                            c.DogName,
                            c.TotalPoints.ToString("F2"),
                            TimeParsingHelper.Format(c.TotalTime),
                            c.RunCount.ToString()
                        })
                        .ToArray()
                })
                .ToArray();

            var fileName = $"WeekendAverage_{selectedEvent?.EventName?.Replace(" ", "") ?? "Event"}_{DateTime.Now:yyyyMMdd}.pdf";
            var tableHead = new[] { "Handler", "Dog", "Total Points", "Total Time", "Runs" };
            var logoUrl = $"{PageState.Alias.BaseUrl}/images/mssa-logo.jpg";

            await JSRuntime.InvokeVoidAsync("mssaExportResultsPdf", fileName, headerLines, sections, tableHead, logoUrl);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error exporting weekend combined PDF for event {EventId}", selectedEventId);
            errorMessage = "Error creating the PDF. Please try again.";
        }
    }

    private string ScoreSheetDownloadUrl =>
        $"{PageState.Alias.BaseUrl}/api/MSSA_Result/trial/{selectedTrialId}/scoresheet?moduleid={ModuleState.ModuleId}";

    // A data: URI rather than a server round-trip - the bytes are already in hand from
    // the import response, and this is a small, one-off file (unmatched rows only).
    private string CompleteTrialErrorsFileUrl =>
        completeTrialResult?.ErrorsFile == null
            ? null
            : $"data:application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;base64,{Convert.ToBase64String(completeTrialResult.ErrorsFile)}";

    private async Task OnScoreSheetSelected(InputFileChangeEventArgs e)
    {
        try
        {
            errorMessage = "";
            successMessage = "";
            importResult = null;

            const long maxFileSize = 10 * 1024 * 1024; // 10 MB
            await using var stream = e.File.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var dto = new ImportScoreSheetDto
            {
                FileName = e.File.Name,
                ContentBase64 = Convert.ToBase64String(memoryStream.ToArray())
            };

            importResult = await ResultService.ImportScoreSheetAsync(selectedTrialId, dto, ModuleState.ModuleId);

            var reloaded = await ResultService.GetTrialRunRowsAsync(selectedTrialId, ModuleState.ModuleId);
            rows = reloaded.Any(r => r.Placing.HasValue) ? SortByClassAndPlacing(reloaded) : reloaded;
            savedEntryIds.Clear();

            await RefreshSelectedEventSummary();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error importing score sheet for trial {TrialId}", selectedTrialId);
            errorMessage = "Error importing that file. Please check it and try again.";
        }
    }

    private async Task OnCompleteTrialSelected(InputFileChangeEventArgs e)
    {
        try
        {
            errorMessage = "";
            successMessage = "";
            completeTrialResult = null;

            const long maxFileSize = 10 * 1024 * 1024; // 10 MB
            await using var stream = e.File.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);

            var dto = new ImportScoreSheetDto
            {
                FileName = e.File.Name,
                ContentBase64 = Convert.ToBase64String(memoryStream.ToArray())
            };

            completeTrialResult = await ResultService.ImportCompleteTrialAsync(selectedTrialId, dto, ModuleState.ModuleId);

            var reloaded = await ResultService.GetTrialRunRowsAsync(selectedTrialId, ModuleState.ModuleId);
            rows = reloaded.Any(r => r.Placing.HasValue) ? SortByClassAndPlacing(reloaded) : reloaded;
            savedEntryIds.Clear();

            await RefreshSelectedEventSummary();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error importing complete trial for trial {TrialId}", selectedTrialId);
            errorMessage = "Error importing that file. Please check it and try again.";
        }
    }

    private async Task OnRowKeyDown(KeyboardEventArgs e, ResultRunRow row)
    {
        if (e.Key == "Enter")
        {
            await SaveRow(row);
        }
    }

    private async Task SaveRow(ResultRunRow row)
    {
        try
        {
            var dto = new SaveResultRowDto
            {
                EntryId = row.EntryId,
                RunTimeStr = row.RunTimeStr,
                TieBreakerTimeStr = row.TieBreakerTimeStr,
                TotalScore = row.TotalScore
            };

            await ResultService.SaveResultRowAsync(row.TrialId, dto, ModuleState.ModuleId);
            savedEntryIds.Add(row.EntryId);

            // Keep the event summary's scored-count in sync without a full reload.
            await RefreshSelectedEventSummary();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error saving result row for entry {EntryId}", row.EntryId);
            errorMessage = "Error saving that row. Please try again.";
        }
    }

    private async Task RefreshSelectedEventSummary()
    {
        var updated = await ResultService.GetScoringEventsAsync(ModuleState.ModuleId);
        events = updated;
    }

    private async Task CalculatePlacingAndPoints()
    {
        try
        {
            errorMessage = "";
            successMessage = "";

            if (rows != null && rows.Any(r => r.Placing.HasValue))
            {
                var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
                    "This trial has already been placed. Recalculating will overwrite the existing placings and points - continue?");
                if (!confirmed)
                {
                    return;
                }
            }

            await ResultService.CalculatePlacingAndPointsAsync(selectedTrialId, ModuleState.ModuleId);

            var calculated = await ResultService.GetTrialRunRowsAsync(selectedTrialId, ModuleState.ModuleId);

            // After calculating, Class + Placing is what you actually want to review -
            // run order (the default view before scores exist) isn't useful here.
            rows = SortByClassAndPlacing(calculated);

            successMessage = "Placing and points calculated.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error calculating placing/points for trial {TrialId}", selectedTrialId);
            errorMessage = "Error calculating placing and points. Please try again.";
        }
    }

    private async Task SubmitForApproval()
    {
        try
        {
            errorMessage = "";
            successMessage = "";

            var result = await ResultService.SubmitEventForApprovalAsync(selectedEventId, ModuleState.ModuleId);
            if (result.Success)
            {
                successMessage = "Submitted for approval.";
                await RefreshSelectedEventSummary();
            }
            else
            {
                errorMessage = string.Join(" ", result.Reasons);
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error submitting event {EventId} for approval", selectedEventId);
            errorMessage = "Error submitting for approval. Please try again.";
        }
    }

    private async Task ApproveEvent(int eventId)
    {
        try
        {
            await ResultService.ApproveEventAsync(eventId, ModuleState.ModuleId);
            pendingEvents = await ResultService.GetPendingApprovalEventsAsync(ModuleState.ModuleId);
            events = await ResultService.GetScoringEventsAsync(ModuleState.ModuleId);
            successMessage = "Event approved.";
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error approving event {EventId}", eventId);
            errorMessage = "Error approving event. Please try again.";
        }
    }

    private static string StatusLabel(string status) => status switch
    {
        EventResultsStatus.PendingApproval => "Pending Approval",
        EventResultsStatus.Approved => "Approved",
        _ => "Not Submitted"
    };

    private static string StatusBadgeClass(string status) => status switch
    {
        EventResultsStatus.PendingApproval => "bg-warning text-dark",
        EventResultsStatus.Approved => "bg-success",
        _ => "bg-secondary"
    };
}
