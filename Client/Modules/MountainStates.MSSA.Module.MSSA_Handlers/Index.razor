@using MountainStates.MSSA.Module.MSSA_Handlers.Services
@using MountainStates.MSSA.Module.MSSA_Handlers.Models
@using MountainStates.MSSA.Module.MSSA_Handlers.Enums
@using Oqtane.Modules.Controls

@namespace MountainStates.MSSA.Module.MSSA_Handlers
@inherits ModuleBase
@inject IMSSA_HandlerService HandlerService
@inject IMSSA_StateService StateService
@inject NavigationManager NavigationManager

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col">
            <h2>Handlers</h2>
        </div>
        <div class="col-auto">
            @if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
            {
                <button type="button" class="btn btn-outline-secondary me-2" @onclick="ShowMergeModal">
                    Merge Handlers
                </button>
            }
            <ActionLink Action="Edit" Security="SecurityAccessLevel.Anonymous" Text="Add Handler"
                        ResourceKey="AddHandler" Class="btn btn-primary" />
        </div>
    </div>

    @* Search/Filter Section *@
    <div class="row mb-3">
        <div class="col-md-3">
            <label for="searchTerm" class="form-label">Search Name</label>
            <input id="searchTerm" class="form-control" @bind="searchTerm"
                   @bind:event="oninput" placeholder="First or Last Name" />
        </div>
        <div class="col-md-2">
            <label for="stateFilter" class="form-label">State</label>
            <select id="stateFilter" class="form-select" @bind="selectedState">
                <option value="">All States</option>
                @if (states != null)
                {
                    <optgroup label="US States">
                        @foreach (var state in states.Where(s => s.Country == "US"))
                        {
                            <option value="@state.StateCode">@state.StateName</option>
                        }
                    </optgroup>
                    <optgroup label="Canadian Provinces">
                        @foreach (var state in states.Where(s => s.Country == "CA"))
                        {
                            <option value="@state.StateCode">@state.StateName</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label for="levelFilter" class="form-label">Handler Level</label>
            <select id="levelFilter" class="form-select" @bind="selectedLevel">
                <option value="">All Levels</option>
                @foreach (var level in HandlerLevel.All)
                {
                    <option value="@level">@level</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex align-items-end">
            <button class="btn btn-primary me-2" @onclick="SearchHandlers">Search</button>
            <button class="btn btn-secondary" @onclick="ClearFilters">Clear</button>
        </div>
    </div>

    @* Results Section *@
    @if (!hasSearched)
    {
        <p><em>Enter search criteria above and click Search to find handlers.</em></p>
    }
    else if (handlers == null)
    {
        <p><em>Loading...</em></p>
    }
    else if (!handlers.Any())
    {
        <p><em>No handlers found.</em></p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>State</th>
                        <th>Level</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var handler in handlers)
                    {
                        <tr>
                            <td>@handler.HandlerId</td>
                            <td>
                                <ActionLink Action="Detail" Parameters="@($"id={handler.HandlerId}")"
                                            Text="@handler.FullName" ResourceKey="ViewHandlerName" />
                            </td>
                            <td>@handler.StateCode</td>
                            <td>@handler.HandlerLevel</td>
                            <td>
                                <ActionLink Action="Detail" Parameters="@($"id={handler.HandlerId}")"
                                            Text="View" ResourceKey="ViewHandler" Class="btn btn-sm btn-info me-1" />
                                @if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
                                {
                                    <ActionLink Action="Edit" Parameters="@($"id={handler.HandlerId}")"
                                                Security="SecurityAccessLevel.Edit" Text="Edit"
                                                ResourceKey="EditHandler" Class="btn btn-sm btn-primary" />
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted">Total: @handlers.Count handler(s)</p>
    }

    @* Merge Handlers Modal *@
    @if (showMergeModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Merge Duplicate Handlers</h5>
                        <button type="button" class="btn-close" @onclick="CloseMergeModal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">
                            Combines two records into one. Competition entries, membership
                            links, and Finals results all move to the handler you keep. Any
                            blank field on the handler you keep is filled in from the
                            duplicate. The duplicate is deactivated afterward, not deleted
                            outright. This cannot be undone from here.
                        </p>

                        <div class="row">
                            <div class="col-md-6">
                                <h6>Keep this handler</h6>
                                @if (keepHandler != null)
                                {
                                    <div class="border rounded p-2 mb-2">
                                        <div><strong>@keepHandler.FullName</strong> (ID: @keepHandler.HandlerId)</div>
                                        <div class="text-muted small">
                                            @(keepHandler.StateCode ?? "State not specified") &middot;
                                            @(keepHandler.HandlerLevel ?? "Level not specified")
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary mt-1" @onclick="() => keepHandler = null">
                                            Change
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="input-group mb-2">
                                        <input class="form-control" placeholder="Search by name"
                                               @bind="keepSearchTerm" @bind:event="oninput"
                                               @onkeyup="@(async e => { if (e.Key == "Enter") await SearchForMerge(true); })" />
                                        <button type="button" class="btn btn-outline-primary" @onclick="() => SearchForMerge(true)">Search</button>
                                    </div>
                                    @if (keepSearchResults != null)
                                    {
                                        @if (!keepSearchResults.Any())
                                        {
                                            <p class="text-muted mb-0"><em>No handlers found.</em></p>
                                        }
                                        else
                                        {
                                            <table class="table table-sm">
                                                <tbody>
                                                    @foreach (var h in keepSearchResults)
                                                    {
                                                        <tr>
                                                            <td>@h.FullName <span class="text-muted">(ID: @h.HandlerId)</span></td>
                                                            <td class="text-end">
                                                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => keepHandler = h">Select</button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    }
                                }
                            </div>
                            <div class="col-md-6">
                                <h6>Merge away this handler</h6>
                                @if (mergeAwayHandler != null)
                                {
                                    <div class="border rounded p-2 mb-2">
                                        <div><strong>@mergeAwayHandler.FullName</strong> (ID: @mergeAwayHandler.HandlerId)</div>
                                        <div class="text-muted small">
                                            @(mergeAwayHandler.StateCode ?? "State not specified") &middot;
                                            @(mergeAwayHandler.HandlerLevel ?? "Level not specified")
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-secondary mt-1" @onclick="() => mergeAwayHandler = null">
                                            Change
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <div class="input-group mb-2">
                                        <input class="form-control" placeholder="Search by name"
                                               @bind="mergeSearchTerm" @bind:event="oninput"
                                               @onkeyup="@(async e => { if (e.Key == "Enter") await SearchForMerge(false); })" />
                                        <button type="button" class="btn btn-outline-primary" @onclick="() => SearchForMerge(false)">Search</button>
                                    </div>
                                    @if (mergeSearchResults != null)
                                    {
                                        @if (!mergeSearchResults.Any())
                                        {
                                            <p class="text-muted mb-0"><em>No handlers found.</em></p>
                                        }
                                        else
                                        {
                                            <table class="table table-sm">
                                                <tbody>
                                                    @foreach (var h in mergeSearchResults)
                                                    {
                                                        <tr>
                                                            <td>@h.FullName <span class="text-muted">(ID: @h.HandlerId)</span></td>
                                                            <td class="text-end">
                                                                <button type="button" class="btn btn-sm btn-primary" @onclick="() => mergeAwayHandler = h">Select</button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    }
                                }
                            </div>
                        </div>

                        @if (keepHandler != null && mergeAwayHandler != null && keepHandler.HandlerId == mergeAwayHandler.HandlerId)
                        {
                            <div class="alert alert-warning mt-2 mb-0">Pick two different handlers.</div>
                        }

                        @if (!string.IsNullOrEmpty(mergeError))
                        {
                            <div class="alert alert-danger mt-3 mb-0">@mergeError</div>
                        }
                        @if (!string.IsNullOrEmpty(mergeMessage))
                        {
                            <div class="alert alert-success mt-3 mb-0">@mergeMessage</div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-danger"
                                disabled="@(!CanMerge || mergingHandlers)" @onclick="ConfirmMerge">
                            @(mergingHandlers ? "Merging..." : "Merge")
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="CloseMergeModal">Close</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<MSSA_Handler> handlers;
    private List<MSSA_State> states;
    private bool hasSearched = false;

    private string searchTerm = "";
    private string selectedState = "";
    private string selectedLevel = "";

    private bool showMergeModal = false;
    private string keepSearchTerm = "";
    private string mergeSearchTerm = "";
    private List<MSSA_Handler> keepSearchResults;
    private List<MSSA_Handler> mergeSearchResults;
    private MSSA_Handler keepHandler;
    private MSSA_Handler mergeAwayHandler;
    private bool mergingHandlers = false;
    private string mergeError = "";
    private string mergeMessage = "";

    private bool CanMerge => keepHandler != null && mergeAwayHandler != null && keepHandler.HandlerId != mergeAwayHandler.HandlerId;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            states = await StateService.GetStatesAsync(ModuleState.ModuleId);
            // Intentionally does not load handlers on page open.
            // The list stays empty until the user searches.
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error loading handlers");
            AddModuleMessage("Error loading handlers", MessageType.Error);
        }
    }

    private async Task SearchHandlers()
    {
        try
        {
            hasSearched = true;
            handlers = null; // shows "Loading..." while the search is in flight

            handlers = await HandlerService.SearchHandlersAsync(
                searchTerm,
                selectedState,
                selectedLevel,
                ModuleState.ModuleId
            );
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error searching handlers");
            AddModuleMessage("Error searching handlers", MessageType.Error);
        }
    }

    private void ClearFilters()
    {
        searchTerm = "";
        selectedState = "";
        selectedLevel = "";
        handlers = null;
        hasSearched = false;
    }

    private void ShowMergeModal()
    {
        keepSearchTerm = "";
        mergeSearchTerm = "";
        keepSearchResults = null;
        mergeSearchResults = null;
        keepHandler = null;
        mergeAwayHandler = null;
        mergingHandlers = false;
        mergeError = "";
        mergeMessage = "";
        showMergeModal = true;
    }

    private void CloseMergeModal()
    {
        showMergeModal = false;
    }

    private async Task SearchForMerge(bool isKeep)
    {
        try
        {
            var term = isKeep ? keepSearchTerm : mergeSearchTerm;
            var results = await HandlerService.SearchHandlersAsync(term, null, null, ModuleState.ModuleId);

            if (isKeep)
            {
                keepSearchResults = results;
            }
            else
            {
                mergeSearchResults = results;
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error searching for handlers to merge");
            mergeError = "Error searching for handlers. Please try again.";
        }
    }

    private async Task ConfirmMerge()
    {
        try
        {
            mergeError = "";
            mergeMessage = "";

            if (!CanMerge)
            {
                return;
            }

            mergingHandlers = true;

            var result = await HandlerService.MergeHandlersAsync(new MergeHandlersDto
            {
                KeepHandlerId = keepHandler.HandlerId,
                MergeHandlerId = mergeAwayHandler.HandlerId
            }, ModuleState.ModuleId);

            if (result == null)
            {
                mergeError = "Merge failed - check that you're logged in as an Admin and both handlers still exist.";
                return;
            }

            mergeMessage = $"Merged \"{mergeAwayHandler.FullName}\" into \"{result.FullName}\".";
            keepHandler = null;
            mergeAwayHandler = null;

            if (hasSearched)
            {
                await SearchHandlers();
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error merging handlers");
            mergeError = "Error merging handlers. Please try again.";
        }
        finally
        {
            mergingHandlers = false;
        }
    }
}