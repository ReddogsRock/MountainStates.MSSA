@using MountainStates.MSSA.Module.MSSA_Handlers.Services
@using MountainStates.MSSA.Module.MSSA_Handlers.Models
@using Oqtane.Modules.Controls

@namespace MountainStates.MSSA.Module.MSSA_Handlers
@inherits ModuleBase
@inject IMSSA_HandlerService HandlerService
@inject NavigationManager NavigationManager

@if (handler == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col">
                <h2>
                    @handler.FullName
                    <span class="badge bg-secondary ms-2">ID: @handler.HandlerId</span>
                </h2>
            </div>
            <div class="col-auto">
                <ActionLink Action="Index" Text="Back to List" ResourceKey="BackToList" Class="btn btn-secondary me-2" />
                @if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
                {
                    <ActionLink Action="Edit" Parameters="@($"id={handler.HandlerId}")"
                                Security="SecurityAccessLevel.Edit" Text="Edit"
                                ResourceKey="EditHandler" Class="btn btn-primary" />
                }
            </div>
        </div>

        @if (PageState.QueryString.ContainsKey("membership"))
        {
            @if (PageState.QueryString["membership"] == "success")
            {
                <div class="alert alert-success">
                    Payment received - thank you! The membership will show as paid here
                    shortly once Stripe confirms the charge.
                </div>
            }
            else if (PageState.QueryString["membership"] == "cancelled")
            {
                <div class="alert alert-warning">
                    The membership payment wasn't completed, so it's still pending.
                    You can try again below.
                </div>
            }
        }

        @* Handler Information *@
        <div class="card mb-3">
            <div class="card-header">
                <h4>Contact Information</h4>
            </div>
            <div class="card-body">
                @if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
                {
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Email:</dt>
                                <dd class="col-sm-8">
                                    @if (!string.IsNullOrEmpty(handler.Email))
                                    {
                                        <a href="mailto:@handler.Email">@handler.Email</a>
                                    }
                                    else
                                    {
                                        <em>Not provided</em>
                                    }
                                </dd>

                                <dt class="col-sm-4">Phone:</dt>
                                <dd class="col-sm-8">@FormatPhone(handler.Phone ?? "Not provided")</dd>


                                <dt class="col-sm-4">Alternate Phone:</dt>
                                <dd class="col-sm-8">@FormatPhone(handler.AlternatePhone ?? "Not provided")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Address:</dt>
                                <dd class="col-sm-8">
                                    @if (!string.IsNullOrEmpty(handler.Address))
                                    {
                                        <text>@handler.Address</text>

                                        <br />
                                        <text>@handler.City, @handler.StateCode @handler.ZipCode</text>
                                    }
                                    else
                                    {
                                        <em>Not provided</em>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                }
                else
                {
                    <dl class="row mb-0">
                        <dt class="col-sm-2">State:</dt>
                        <dd class="col-sm-10">@(string.IsNullOrEmpty(handler.StateCode) ? "Not provided" : handler.StateCode)</dd>
                    </dl>
                }
            </div>
        </div>

        @* Competition Information *@
        <div class="card mb-3">
            <div class="card-header">
                <h4>Competition Information</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Handler Level:</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-primary">@(handler.HandlerLevel ?? "Not set")</span>
                    </dd>

                    <dt class="col-sm-3">Level Move-Up Date:</dt>
                    <dd class="col-sm-9">@(handler.LevelMoveUpDate?.ToString("MMM dd, yyyy") ?? "N/A")</dd>

                    <dt class="col-sm-3">Photo Release:</dt>
                    <dd class="col-sm-9">
                        @if (handler.PhotoReleaseConsent)
                        {
                            <span class="text-success">✓ Consent given</span>
                        }
                        else
                        {
                            <span class="text-muted">Not provided</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>

        @* Membership *@
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Membership</h4>
                <button type="button" class="btn btn-sm btn-primary" @onclick="ShowPurchaseMembership">
                    Purchase / Renew Membership
                </button>
            </div>
            <div class="card-body">
                @if (handler.Memberships == null || !handler.Memberships.Any())
                {
                    <p><em>No membership records.</em></p>
                }
                else
                {
                    var current = handler.Memberships.FirstOrDefault(m => m.IsCurrentlyActive);
                    <p class="mb-3">
                        <strong>Current Status:</strong>
                        @if (current != null)
                        {
                            <span class="badge bg-success">Active</span>
                            <span class="ms-2">
                                @current.MembershipTypeName &mdash; @current.StartYear&ndash;@(current.EndYear?.ToString() ?? "Lifetime")
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Not Active</span>
                        }
                    </p>

                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Years</th>
                                <th>Amount</th>
                                <th>Paid By</th>
                                <th>Date Received</th>
                                <th>Members</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in handler.Memberships)
                            {
                                <tr>
                                    <td>@m.MembershipTypeName</td>
                                    <td>@m.StartYear&ndash;@(m.EndYear?.ToString() ?? "Lifetime")</td>
                                    <td>@(m.Amount.HasValue ? $"${m.Amount.Value:N2}" : "N/A")</td>
                                    <td>@m.PaidBy</td>
                                    <td>@(m.DateReceived?.ToString("MMM dd, yyyy") ?? "N/A")</td>
                                    <td>@string.Join(", ", m.Members.Select(x => x.HandlerName))</td>
                                    <td>
                                        @if (m.IsCurrentlyActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        @* Purchase/Renew Membership Modal *@
        @if (showMembershipModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Purchase / Renew Membership</h5>
                            <button type="button" class="btn-close" @onclick="CloseMembershipModal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="row g-2">
                                <div class="col-md-7">
                                    <label class="form-label">Membership Type</label>
                                    <select class="form-select" @bind="selectedMembershipType">
                                        <option value="AI">Annual Individual</option>
                                        <option value="AF">Annual Family</option>
                                        <option value="3I">3 Year Individual</option>
                                        <option value="3F">3 Year Family</option>
                                        <option value="Lifetime">Lifetime</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label">Start Year</label>
                                    <input type="number" class="form-control" @bind="membershipStartYear" />
                                </div>
                            </div>

                            @if (selectedMembershipType == "AF" || selectedMembershipType == "3F")
                            {
                                <hr />
                                <p class="mb-2">
                                    <strong>Family members</strong> - @handler.FullName is included automatically.
                                    Add anyone else this membership should cover.
                                </p>

                                <div class="row g-2">
                                    <div class="col-md-8">
                                        <input class="form-control" placeholder="Search by name" @bind="familySearchTerm" @bind:event="oninput"
                                               @onkeyup="@(async e => { if (e.Key == "Enter") await SearchFamilyMembers(); })" />
                                    </div>
                                    <div class="col-md-4">
                                        <button type="button" class="btn btn-outline-primary w-100" @onclick="SearchFamilyMembers">Search</button>
                                    </div>
                                </div>

                                @if (familySearchResults != null)
                                {
                                    @if (!familySearchResults.Any())
                                    {
                                        <p class="text-muted mt-2 mb-0"><em>No handlers found.</em></p>
                                    }
                                    else
                                    {
                                        <table class="table table-sm mt-2">
                                            <tbody>
                                                @foreach (var h in familySearchResults)
                                                {
                                                    <tr>
                                                        <td>@h.FullName</td>
                                                        <td>@h.StateCode</td>
                                                        <td class="text-end">
                                                            <button type="button" class="btn btn-sm btn-outline-primary"
                                                                    disabled="@selectedFamilyMembers.Any(x => x.HandlerId == h.HandlerId)"
                                                                    @onclick="() => AddFamilyMember(h)">
                                                                Add
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                }

                                @if (selectedFamilyMembers.Any())
                                {
                                    <p class="mb-1 mt-2"><strong>Also covered:</strong></p>
                                    <ul class="list-group">
                                        @foreach (var m in selectedFamilyMembers)
                                        {
                                            <li class="list-group-item d-flex justify-content-between align-items-center py-1">
                                                @m.FullName
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFamilyMember(m.HandlerId)">Remove</button>
                                            </li>
                                        }
                                    </ul>
                                }
                            }

                            @if (!string.IsNullOrEmpty(membershipErrorMessage))
                            {
                                <div class="alert alert-danger mt-3 mb-0">@membershipErrorMessage</div>
                            }
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary" disabled="@creatingMembershipCheckout" @onclick="SubmitMembershipPurchase">
                                @(creatingMembershipCheckout ? "Redirecting to payment..." : "Continue to Payment")
                            </button>
                            <button type="button" class="btn btn-secondary" @onclick="CloseMembershipModal">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Competition Entries *@
        <div class="card">
            <div class="card-header">
                <h4>Competition Entries</h4>
            </div>
            <div class="card-body">
                @if (entries == null)
                {
                    <p><em>Loading entries...</em></p>
                }
                else if (!entries.Any())
                {
                    <p><em>No competition entries found.</em></p>
                }
                else
                {
                    @* Filter Controls *@
                    <div class="row mb-3">
                        <div class="col-md-2">
                            <label class="form-label">Year</label>
                            <select class="form-select form-select-sm" @bind="selectedYear" @bind:after="FilterEntries">
                                <option value="">All Years</option>
                                @foreach (var year in entries.Select(e => e.Year).Distinct().OrderByDescending(y => y))
                                {
                                    <option value="@year">@year</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Class</label>
                            <select class="form-select form-select-sm" @bind="selectedClass" @bind:after="FilterEntries">
                                <option value="">All Classes</option>
                                @foreach (var className in entries.Select(e => e.ClassName).Distinct().OrderBy(c => c))
                                {
                                    <option value="@className">@className</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Dog</label>
                            <select class="form-select form-select-sm" @bind="selectedDog" @bind:after="FilterEntries">
                                <option value="">All Dogs</option>
                                @foreach (var dogName in entries.Select(e => e.DogName).Distinct().OrderBy(d => d))
                                {
                                    <option value="@dogName">@dogName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Placing</label>
                            <select class="form-select form-select-sm" @bind="selectedPlacing" @bind:after="FilterEntries">
                                <option value="">All</option>
                                <option value="1">1st Place</option>
                                <option value="2">2nd Place</option>
                                <option value="3">3rd Place</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button class="btn btn-sm btn-secondary" @onclick="ClearEntryFilters">Clear Filters</button>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-striped table-sm">
                            <thead>
                                <tr>
                                    <th @onclick='() => SortEntries("Date")' style="cursor: pointer;">
                                        Date @GetSortIcon("Date")
                                    </th>
                                    <th @onclick='() => SortEntries("Event")' style="cursor: pointer;">
                                        Event @GetSortIcon("Event")
                                    </th>
                                    <th @onclick='() => SortEntries("Dog")' style="cursor: pointer;">
                                        Dog @GetSortIcon("Dog")
                                    </th>
                                    <th @onclick='() => SortEntries("Class")' style="cursor: pointer;">
                                        Class @GetSortIcon("Class")
                                    </th>
                                    <th>Stock</th>
                                    <th @onclick='() => SortEntries("Placing")' style="cursor: pointer;">
                                        Placing @GetSortIcon("Placing")
                                    </th>
                                    <th @onclick='() => SortEntries("Points")' style="cursor: pointer;">
                                        Points @GetSortIcon("Points")
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in filteredEntries)
                                {
                                    <tr>
                                        <td>@entry.TrialDate.ToString("MMM dd, yyyy")</td>
                                        <td>@entry.EventName</td>
                                        <td>@entry.DogName</td>
                                        <td>@entry.ClassName @entry.SubClassName</td>
                                        <td>@entry.Stock</td>
                                        <td>
                                            @if (entry.Placing.HasValue)
                                            {
                                                if (entry.Placing.Value <= 3)
                                                {
                                                    <span class="badge bg-warning">@entry.Placing</span>
                                                }
                                                else
                                                {
                                                    @entry.Placing
                                                }
                                            }
                                        </td>
                                        <td>@entry.TrialPoints</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="text-muted">Showing @filteredEntries.Count() of @entries.Count entries</p>
                }
            </div>
        </div>
    </div>
}

@code {
    private MSSA_Handler handler;
    private List<MSSA_HandlerEntry> entries;
    private IEnumerable<MSSA_HandlerEntry> filteredEntries = new List<MSSA_HandlerEntry>();

    private string selectedYear = "";
    private string selectedClass = "";
    private string selectedDog = "";
    private string selectedPlacing = "";
    private string sortColumn = "Date";
    private bool sortAscending = false;

    private bool showMembershipModal = false;
    private string selectedMembershipType = "AI";
    private int membershipStartYear = DateTime.Today.Year;
    private string familySearchTerm = "";
    private List<MSSA_Handler> familySearchResults;
    private List<MSSA_Handler> selectedFamilyMembers = new();
    private string membershipErrorMessage = "";
    private bool creatingMembershipCheckout = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            int handlerId = int.Parse(PageState.QueryString["id"]);
            handler = await HandlerService.GetHandlerAsync(handlerId, ModuleState.ModuleId);
            entries = await HandlerService.GetHandlerEntriesAsync(handlerId, ModuleState.ModuleId);

            filteredEntries = entries;
            SortEntries(sortColumn);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error loading handler details");
            AddModuleMessage("Error loading handler details", MessageType.Error);
        }
    }

    private void FilterEntries()
    {
        filteredEntries = entries.AsEnumerable();

        if (!string.IsNullOrEmpty(selectedYear))
        {
            var year = int.Parse(selectedYear);
            filteredEntries = filteredEntries.Where(e => e.Year == year);
        }

        if (!string.IsNullOrEmpty(selectedClass))
        {
            filteredEntries = filteredEntries.Where(e => e.ClassName == selectedClass);
        }

        if (!string.IsNullOrEmpty(selectedDog))
        {
            filteredEntries = filteredEntries.Where(e => e.DogName == selectedDog);
        }

        if (!string.IsNullOrEmpty(selectedPlacing))
        {
            var placing = int.Parse(selectedPlacing);
            filteredEntries = filteredEntries.Where(e => e.Placing == placing);
        }

        filteredEntries = filteredEntries.ToList();
        SortEntries(sortColumn);
    }

    private void ClearEntryFilters()
    {
        selectedYear = "";
        selectedClass = "";
        selectedDog = "";
        selectedPlacing = "";
        FilterEntries();
    }

    private void SortEntries(string column)
    {
        if (sortColumn == column)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        filteredEntries = column switch
        {
            "Date" => sortAscending ? filteredEntries.OrderBy(e => e.TrialDate).ToList() : filteredEntries.OrderByDescending(e => e.TrialDate).ToList(),
            "Event" => sortAscending ? filteredEntries.OrderBy(e => e.EventName).ToList() : filteredEntries.OrderByDescending(e => e.EventName).ToList(),
            "Dog" => sortAscending ? filteredEntries.OrderBy(e => e.DogName).ToList() : filteredEntries.OrderByDescending(e => e.DogName).ToList(),
            "Class" => sortAscending ? filteredEntries.OrderBy(e => e.ClassName).ToList() : filteredEntries.OrderByDescending(e => e.ClassName).ToList(),
            "Placing" => sortAscending ? filteredEntries.OrderBy(e => e.Placing ?? int.MaxValue).ToList() : filteredEntries.OrderByDescending(e => e.Placing ?? int.MaxValue).ToList(),
            "Points" => sortAscending ? filteredEntries.OrderBy(e => e.TrialPoints ?? 0).ToList() : filteredEntries.OrderByDescending(e => e.TrialPoints ?? 0).ToList(),
            _ => filteredEntries
        };
    }

    private string GetSortIcon(string column)
    {
        if (sortColumn != column) return "";
        return sortAscending ? "▲" : "▼";
    }

    private string FormatPhone(string phone)
    {
        if (!string.IsNullOrEmpty(phone) && phone.Length == 10)
        {
            return $"({phone.Substring(0, 3)}) {phone.Substring(3, 3)}-{phone.Substring(6, 4)}";
        }
        return phone ?? "";
    }

    private void ShowPurchaseMembership()
    {
        selectedMembershipType = "AI";
        membershipStartYear = DateTime.Today.Year;
        familySearchTerm = "";
        familySearchResults = null;
        selectedFamilyMembers = new List<MSSA_Handler>();
        membershipErrorMessage = "";
        creatingMembershipCheckout = false;
        showMembershipModal = true;
    }

    private void CloseMembershipModal()
    {
        showMembershipModal = false;
    }

    private async Task SearchFamilyMembers()
    {
        if (string.IsNullOrWhiteSpace(familySearchTerm))
        {
            familySearchResults = new List<MSSA_Handler>();
            return;
        }

        var results = await HandlerService.SearchHandlersAsync(familySearchTerm, null, null, ModuleState.ModuleId);
        // The handler viewing this page is already covered automatically - don't show
        // them again as a separate "family member" to add.
        familySearchResults = results.Where(h => h.HandlerId != handler.HandlerId).ToList();
    }

    private void AddFamilyMember(MSSA_Handler h)
    {
        if (!selectedFamilyMembers.Any(x => x.HandlerId == h.HandlerId))
        {
            selectedFamilyMembers.Add(h);
        }
    }

    private void RemoveFamilyMember(int handlerId)
    {
        selectedFamilyMembers.RemoveAll(x => x.HandlerId == handlerId);
    }

    private async Task SubmitMembershipPurchase()
    {
        try
        {
            membershipErrorMessage = "";
            creatingMembershipCheckout = true;

            var memberHandlerIds = new List<int> { handler.HandlerId };
            memberHandlerIds.AddRange(selectedFamilyMembers.Select(m => m.HandlerId));

            var membership = new MSSA_Membership
            {
                MembershipType = selectedMembershipType,
                StartYear = membershipStartYear,
                PrimaryHandlerId = handler.HandlerId,
                MemberHandlerIds = memberHandlerIds.Distinct().ToList()
            };

            var saved = await HandlerService.AddMembershipAsync(membership, ModuleState.ModuleId);

            var successUrl = NavigationManager.ToAbsoluteUri(EditUrl("Detail", $"id={handler.HandlerId}&membership=success")).ToString();
            var cancelUrl = NavigationManager.ToAbsoluteUri(EditUrl("Detail", $"id={handler.HandlerId}&membership=cancelled")).ToString();

            var checkout = await HandlerService.CreateMembershipCheckoutSessionAsync(new CreateMembershipCheckoutDto
            {
                MembershipId = saved.MembershipId,
                MembershipType = selectedMembershipType,
                SuccessUrl = successUrl,
                CancelUrl = cancelUrl
            }, ModuleState.ModuleId);

            await JSRuntime.InvokeVoidAsync("window.location.assign", checkout.CheckoutUrl);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error starting membership purchase");
            membershipErrorMessage = "Error starting payment. Please try again.";
            creatingMembershipCheckout = false;
        }
    }
}