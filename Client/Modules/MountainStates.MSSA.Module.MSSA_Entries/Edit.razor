@using MountainStates.MSSA.Module.MSSA_Entries.Services
@using MountainStates.MSSA.Module.MSSA_Entries.Models
@using MountainStates.MSSA.Module.MSSA_Events.Services
@using MountainStates.MSSA.Module.MSSA_Events.Models
@using MountainStates.MSSA.Module.MSSA_Handlers.Services
@using MountainStates.MSSA.Module.MSSA_Handlers.Models
@using MountainStates.MSSA.Module.MSSA_Dogs.Services
@using MountainStates.MSSA.Module.MSSA_Dogs.Models
@using MountainStates.MSSA.Module.MSSA_Handlers.Enums
@using Oqtane.Modules.Controls

@namespace MountainStates.MSSA.Module.MSSA_Entries
@inherits ModuleBase
@inject IMSSA_EntryService EntryService
@inject IMSSA_EventService EventService
@inject IMSSA_HandlerService HandlerService
@inject IMSSA_DogService DogService
@inject IMSSA_StateService StateService
@inject NavigationManager NavigationManager

@if (entryId == -1)
{
    @* ============ ADD ENTRIES (bulk workflow) ============ *@
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col">
                <h2>Add Entries</h2>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success" role="alert">
                @successMessage
            </div>
        }

        @* Event Selection *@
        <div class="card mb-3">
            <div class="card-body">
                <label for="addEventSelect" class="form-label"><strong>Event</strong> <span class="text-danger">*</span></label>
                <select id="addEventSelect" class="form-select" @bind="selectedEventId" @bind:after="OnAddEventChanged">
                    <option value="">-- Select Event --</option>
                    @foreach (var evt in AddableEvents)
                    {
                        <option value="@evt.EventId">@evt.EventName - @evt.DateRange</option>
                    }
                </select>
            </div>
        </div>

        @if (selectedEventId > 0)
        {
            @* Handler Selection *@
            <div class="card mb-3">
                <div class="card-header"><h4>Handler</h4></div>
                <div class="card-body">
                    @if (selectedHandler != null)
                    {
                        <div class="alert alert-success d-flex justify-content-between align-items-center mb-0">
                            <span><strong>Selected:</strong> @selectedHandler.FullName</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearHandlerSelection">Change</button>
                        </div>
                    }
                    else
                    {
                        <MSSA_HandlerPicker ModuleId="ModuleState.ModuleId" States="states" OnSelected="SelectHandler" />
                    }
                </div>
            </div>

            @* Dog Selection *@
            <div class="card mb-3">
                <div class="card-header"><h4>Dog</h4></div>
                <div class="card-body">
                    @if (selectedDog != null)
                    {
                        <div class="alert alert-success d-flex justify-content-between align-items-center mb-0">
                            <span><strong>Selected:</strong> @selectedDog.Name @(!string.IsNullOrEmpty(selectedDog.Breed) ? $"({selectedDog.Breed})" : "")</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearDogSelection">Change</button>
                        </div>
                    }
                    else
                    {
                        <MSSA_DogPicker ModuleId="ModuleState.ModuleId" NewDogFactory="NewDogDefaults" OnSelected="SelectDog" />
                    }
                </div>
            </div>

            @* Runs Grid *@
            <div class="card mb-3">
                <div class="card-header"><h4>Select Runs</h4></div>
                <div class="card-body">
                    @if (offerings == null)
                    {
                        <p><em>Loading...</em></p>
                    }
                    else if (!offerings.Any())
                    {
                        <p class="text-muted"><em>No run offerings have been planned for this event yet. Add them from the event's Edit page first.</em></p>
                    }
                    else
                    {
                        <table class="table table-bordered align-middle">
                            <thead>
                                <tr>
                                    <th>Class</th>
                                    <th>Stock / Venue</th>
                                    <th>Runs</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var offering in offerings)
                                {
                                    var matchingTrials = TrialsForOffering(offering);
                                    <tr>
                                        <td>@offering.ClassName @offering.SubClassName</td>
                                        <td>@offering.Stock / @offering.Venue</td>
                                        <td>
                                            @if (!matchingTrials.Any())
                                            {
                                                <span class="text-muted"><em>No trials created yet for this Stock/Venue.</em></span>
                                            }
                                            else
                                            {
                                                @foreach (var trial in matchingTrials)
                                                {
                                                    var key = (offering.OfferingId, trial.TrialId);
                                                    <div class="form-check mb-1">
                                                        <input type="checkbox" class="form-check-input"
                                                               id="@($"run_{key.Item1}_{key.Item2}")"
                                                               checked="@checkedCells.Contains(key)"
                                                               @onchange="@(e => ToggleCell(key, (bool)e.Value))" />
                                                        <label class="form-check-label" for="@($"run_{key.Item1}_{key.Item2}")">@trial.TrialName</label>

                                                        <div class="form-check form-check-inline ms-3">
                                                            <input type="checkbox" class="form-check-input"
                                                                   id="@($"paid_{key.Item1}_{key.Item2}")"
                                                                   checked="@paidCells.Contains(key)"
                                                                   @onchange="@(e => TogglePaidCell(key, (bool)e.Value))" />
                                                            <label class="form-check-label" for="@($"paid_{key.Item1}_{key.Item2}")">Paid</label>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }

                    <button type="button" class="btn btn-success" @onclick="SubmitEntries"
                            disabled="@(selectedHandler == null || selectedDog == null || !checkedCells.Any())">
                        Add Entries
                    </button>
                </div>
            </div>

            @* Entries List for this Event *@
            <div class="card mb-3">
                <div class="row mb-2 mx-0 pt-3">
                    <div class="col">
                        <h4>Entries for This Event</h4>
                    </div>
                </div>
                <div class="card-body">
                    @if (eventEntries == null)
                    {
                        <p><em>Loading...</em></p>
                    }
                    else if (!eventEntries.Any())
                    {
                        <p class="text-muted"><em>No entries yet for this event.</em></p>
                    }
                    else
                    {
                        var grouped = eventEntries
                            .GroupBy(e => new { e.TrialId, e.TrialDate, TrialName = trials?.FirstOrDefault(t => t.TrialId == e.TrialId)?.TrialName, e.Stock })
                            .OrderBy(g => g.Key.TrialDate)
                            .ThenBy(g => g.Key.TrialId);

                        @foreach (var group in grouped)
                        {
                            <h5 class="mt-2">@(group.Key.TrialName ?? group.Key.TrialDate.ToString("MMM dd, yyyy")) (@group.Key.Stock)</h5>
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Level</th>
                                        <th>Handler ID</th>
                                        <th>Handler</th>
                                        <th>Dog ID</th>
                                        <th>Dog</th>
                                        <th>Paid</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var e in group.OrderBy(x => classes?.FirstOrDefault(c => c.ClassName == x.ClassName && c.SubClassName == x.SubClassName)?.PrintOrder ?? 999)
                                                            .ThenBy(x => x.HandlerName))
                                    {
                                        <tr>
                                            <td>@e.ClassName @e.SubClassName</td>
                                            <td>@e.HandlerId</td>
                                            <td>@e.HandlerName</td>
                                            <td>@e.DogId</td>
                                            <td>@e.DogName</td>
                                            <td>@(e.IsPaid ? "Yes" : "No")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <form @onsubmit="SaveEntry">
    <div class="container-fluid">
        <div class="row mb-3">
            <div class="col">
                <h2>Edit Entry</h2>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        @* Trial Selection *@
        <div class="card mb-3">
            <div class="card-header">
                <h4>Trial Selection</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label for="eventSelect" class="form-label">Event <span class="text-danger">*</span></label>
                        <select id="eventSelect" class="form-select" @bind="selectedEventId" @bind:after="OnEventChanged"
                                disabled="@(entryId != -1)">
                            <option value="">-- Select Event --</option>
                            @if (events != null)
                            {
                                @foreach (var evt in events)
                                {
                                    <option value="@evt.EventId">@evt.EventName - @evt.DateRange</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="trialSelect" class="form-label">Trial <span class="text-danger">*</span></label>
                        <select id="trialSelect" class="form-select" @bind="entry.TrialId"
                                disabled="@(trials == null || !trials.Any() || entryId != -1)">
                            <option value="0">-- Select Trial --</option>
                            @if (trials != null)
                            {
                                @foreach (var trial in trials)
                                {
                                    <option value="@trial.TrialId">@trial.TrialDate.ToString("MMM dd, yyyy") - @trial.TrialName (@trial.Stock)</option>
                                }
                            }
                        </select>
                        @if (entryId != -1)
                        {
                            <small class="form-text text-muted">Trial cannot be changed after entry is created</small>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Competitor Information *@
        <div class="card mb-3">
            <div class="card-header">
                <h4>Competitor Information</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label">Handler <span class="text-danger">*</span></label>
                        @if (selectedHandler != null)
                        {
                            <div class="alert alert-success d-flex justify-content-between align-items-center mb-0">
                                <span>@selectedHandler.FullName</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearHandlerSelection">Change</button>
                            </div>
                        }
                        else
                        {
                            <MSSA_HandlerPicker ModuleId="ModuleState.ModuleId" States="states" OnSelected="SelectHandler" />
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Dog <span class="text-danger">*</span></label>
                        @if (selectedDog != null)
                        {
                            <div class="alert alert-success d-flex justify-content-between align-items-center mb-0">
                                <span>@selectedDog.Name @(!string.IsNullOrEmpty(selectedDog.Breed) ? $"({selectedDog.Breed})" : "")</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearDogSelection">Change</button>
                            </div>
                        }
                        else
                        {
                            <MSSA_DogPicker ModuleId="ModuleState.ModuleId" NewDogFactory="NewDogDefaults" OnSelected="SelectDog" />
                        }
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-4">
                        <label for="classSelect" class="form-label">Class <span class="text-danger">*</span></label>
                        <select id="classSelect" class="form-select" @bind="entry.ClassId">
                            <option value="0">-- Select Class --</option>
                            @if (classes != null)
                            {
                                @foreach (var cls in classes.OrderBy(c => c.PrintOrder))
                                {
                                    <option value="@cls.ClassId">@cls.ClassName @cls.SubClassName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="runOrder" class="form-label">Run Order</label>
                        <input id="runOrder" type="number" class="form-control" @bind="entry.RunOrder" min="1" />
                    </div>
                    <div class="col-md-3">
                        <div class="form-check" style="margin-top: 32px;">
                            <input type="checkbox" class="form-check-input" id="handlerMember" @bind="entry.HandlerIsMSSAMember" />
                            <label class="form-check-label" for="handlerMember">Handler is MSSA Member</label>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-check" style="margin-top: 32px;">
                            <input type="checkbox" class="form-check-input" id="entryPaid" @bind="entry.IsPaid" />
                            <label class="form-check-label" for="entryPaid">Paid</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Scoring *@
        <div class="card mb-3">
            <div class="card-header">
                <h4>Scoring</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-12">
                        <label class="form-label"><strong>Obstacle Scores</strong></label>
                        <div class="row">
                            <div class="col-md-2">
                                <label class="form-label">Obstacle 1</label>
                                <input type="number" step="0.01" class="form-control" @bind="entry.ObstacleScore1" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Obstacle 2</label>
                                <input type="number" step="0.01" class="form-control" @bind="entry.ObstacleScore2" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Obstacle 3</label>
                                <input type="number" step="0.01" class="form-control" @bind="entry.ObstacleScore3" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Obstacle 4</label>
                                <input type="number" step="0.01" class="form-control" @bind="entry.ObstacleScore4" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Obstacle 5</label>
                                <input type="number" step="0.01" class="form-control" @bind="entry.ObstacleScore5" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Penalty</label>
                                <input type="number" step="0.01" class="form-control text-danger" @bind="entry.Penalty" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-2">
                                <label class="form-label">Obstacle 6</label>
                                <input type="number" step="0.01" class="form-control" @bind="entry.ObstacleScore6" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Obstacle 7</label>
                                <input type="number" step="0.01" class="form-control" @bind="entry.ObstacleScore7" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Obstacle 8</label>
                                <input type="number" step="0.01" class="form-control" @bind="entry.ObstacleScore8" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Obstacle 9</label>
                                <input type="number" step="0.01" class="form-control" @bind="entry.ObstacleScore9" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label"><strong>Total Score</strong></label>
                                <div class="form-control bg-light">
                                    <strong>@(entry.TotalScore?.ToString("F2") ?? "0.00")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Results *@
        <div class="card mb-3">
            <div class="card-header">
                <h4>Results</h4>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label for="placing" class="form-label">Placing</label>
                        <input id="placing" type="number" class="form-control" @bind="entry.Placing" min="1" />
                    </div>
                    <div class="col-md-3">
                        <label for="trialPoints" class="form-label">Trial Points</label>
                        <input id="trialPoints" type="number" class="form-control" @bind="entry.TrialPoints" min="0" />
                    </div>
                    <div class="col-md-3">
                        <label for="tieBreakerTime" class="form-label">Tie Breaker Time (mm:ss)</label>
                        <input id="tieBreakerTime" type="text" class="form-control" @bind="tieBreakerTimeString"
                               placeholder="mm:ss" pattern="[0-9]{1,2}:[0-9]{2}" />
                    </div>
                    <div class="col-md-3">
                        <label for="runTime" class="form-label">Run Time (mm:ss)</label>
                        <input id="runTime" type="text" class="form-control" @bind="runTimeString"
                               placeholder="mm:ss" pattern="[0-9]{1,2}:[0-9]{2}" />
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-12">
                        <label for="comments" class="form-label">Comments</label>
                        <textarea id="comments" class="form-control" @bind="entry.Comments" rows="3"></textarea>
                    </div>
                </div>
            </div>
        </div>

        @* Action Buttons *@
        <div class="row">
            <div class="col">
                <button type="submit" class="btn btn-success me-2">
                    <span class="oi oi-check"></span> Save
                </button>
                <ActionLink Action="Index" Parameters="@($"trialId={entry.TrialId}")" Text="Cancel" ResourceKey="Cancel" Class="btn btn-secondary me-2" />
                @if (entryId != -1)
                {
                    <ActionLink Action="Detail" Parameters="@($"id={entryId}&trialId={entry.TrialId}")" Text="View Details"
                                ResourceKey="ViewDetails" Class="btn btn-info me-2" />
                    <button type="button" class="btn btn-danger" @onclick="DeleteEntry">
                        <span class="oi oi-trash"></span> Delete
                    </button>
                }
            </div>
        </div>
    </div>
    </form>
}

@code {
    private int entryId = -1;
    private MSSA_Entry entry = new();
    private List<MSSA_Event> events;
    private List<MSSA_Trial> trials;
    private List<MSSA_Class> classes;

    private int selectedEventId = 0;
    private string errorMessage = "";
    private string successMessage = "";
    private string runTimeString = "";
    private string tieBreakerTimeString = "";

    // Add-mode only
    private List<MSSA_EventClassOffering> offerings;
    private List<EntryListItem> eventEntries;

    // Shared by the Handler/Dog pickers (MSSA_HandlerPicker/MSSA_DogPicker) in both Add
    // and Edit mode.
    private List<MSSA_State> states;

    private MSSA_Handler selectedHandler;
    private MSSA_Dog selectedDog;

    private HashSet<(int OfferingId, int TrialId)> checkedCells = new();

    // Tracked independently of checkedCells so toggling Paid before/after checking the
    // run itself both work - only cells that end up in checkedCells at submit time
    // actually turn into entries, so a stray Paid flag on an unchecked run is harmless.
    private HashSet<(int OfferingId, int TrialId)> paidCells = new();

    private List<int> myTeamEventIds = new();

    // Admin can add entries to any event; a Trial Secretary only to events they own,
    // or one they've been added to as a team member (see myTeamEventIds). A
    // Scorekeeper doesn't create entries at all, so they get nothing here. Used for
    // the Add-mode Event dropdown.
    private IEnumerable<MSSA_Event> AddableEvents
    {
        get
        {
            if (events == null) return Enumerable.Empty<MSSA_Event>();

            if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
            {
                return events;
            }

            return events.Where(e => e.CreatedByUserId == PageState.User.UserId || myTeamEventIds.Contains(e.EventId));
        }
    }

    // Admin can edit any entry. A Trial Secretary only entries whose Event they own,
    // or one they've been added to as a team member. A Scorekeeper only entries whose
    // Trial they're assigned to.
    private async Task<bool> CanEditEntryAsync(MSSA_Entry entry)
    {
        if (UserSecurity.IsAuthorized(PageState.User, RoleNames.Admin))
        {
            return true;
        }

        if (UserSecurity.IsAuthorized(PageState.User, MSSARoles.TrialSecretary))
        {
            if (entry.EventCreatedByUserId == PageState.User.UserId)
            {
                return true;
            }

            var trial = await EventService.GetTrialAsync(entry.TrialId, ModuleState.ModuleId);
            if (trial != null && myTeamEventIds.Contains(trial.EventId))
            {
                return true;
            }
        }

        return UserSecurity.IsAuthorized(PageState.User, MSSARoles.Scorekeeper)
            && entry.TrialScorekeeperUserId == PageState.User.UserId;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            events = await EventService.GetEventsAsync(ModuleState.ModuleId);
            classes = await EntryService.GetClassesAsync(ModuleState.ModuleId);

            if (UserSecurity.IsAuthorized(PageState.User, MSSARoles.TrialSecretary))
            {
                myTeamEventIds = await EventService.GetMyTeamEventIdsAsync(ModuleState.ModuleId);
            }

            // Needed for the quick-add Handler form in both Add and Edit mode.
            states = await StateService.GetStatesAsync(ModuleState.ModuleId);

            if (PageState.QueryString.ContainsKey("id"))
            {
                entryId = int.Parse(PageState.QueryString["id"]);

                entry = await EntryService.GetEntryAsync(entryId, ModuleState.ModuleId);

                if (!await CanEditEntryAsync(entry))
                {
                    // Trial Secretary trying to edit an entry outside an event they own -
                    // bounce out before they fill in a form the server will just reject.
                    NavigationManager.NavigateTo(NavigateUrl());
                    return;
                }

                // Pre-populate the Handler/Dog search pickers with the entry's current values.
                selectedHandler = entry.HandlerId > 0 ? await HandlerService.GetHandlerAsync(entry.HandlerId, ModuleState.ModuleId) : null;
                selectedDog = entry.DogId > 0 ? await DogService.GetDogAsync(entry.DogId, ModuleState.ModuleId) : null;

                // Load the event and trials for this entry
                var selectedTrial = await EventService.GetTrialAsync(entry.TrialId, ModuleState.ModuleId);
                if (selectedTrial != null)
                {
                    selectedEventId = selectedTrial.EventId;
                    trials = await EventService.GetEventTrialsAsync(selectedEventId, ModuleState.ModuleId);
                }

                // Convert TimeSpan to string for display
                if (entry.RunTime.HasValue)
                {
                    runTimeString = $"{(int)entry.RunTime.Value.TotalMinutes}:{entry.RunTime.Value.Seconds:D2}";
                }
                if (entry.TieBreakerTime.HasValue)
                {
                    tieBreakerTimeString = $"{(int)entry.TieBreakerTime.Value.TotalMinutes}:{entry.TieBreakerTime.Value.Seconds:D2}";
                }
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error loading entry for edit");
            AddModuleMessage("Error loading entry", MessageType.Error);
        }
    }

    // ============ ADD MODE ============

    private async Task OnAddEventChanged()
    {
        selectedHandler = null;
        selectedDog = null;
        checkedCells.Clear();
        paidCells.Clear();
        errorMessage = "";
        successMessage = "";

        if (selectedEventId > 0)
        {
            offerings = await EventService.GetEventOfferingsAsync(selectedEventId, ModuleState.ModuleId);
            trials = await EventService.GetEventTrialsAsync(selectedEventId, ModuleState.ModuleId);
            await LoadEventEntries();
        }
        else
        {
            offerings = null;
            trials = null;
            eventEntries = null;
        }
    }

    // Which real Trials satisfy this offering: matching Stock+Venue, ordered by date,
    // capped at the offering's PlannedRuns count. If fewer trials exist than planned
    // (e.g. someone deleted one), fewer checkboxes just show up - never an invalid state.
    private List<MSSA_Trial> TrialsForOffering(MSSA_EventClassOffering offering)
    {
        if (trials == null) return new List<MSSA_Trial>();
        return trials
            .Where(t => t.Stock == offering.Stock && t.Venue == offering.Venue)
            .OrderBy(t => t.TrialDate)
            .ThenBy(t => t.TrialId)
            .Take(offering.PlannedRuns)
            .ToList();
    }

    private void ToggleCell((int OfferingId, int TrialId) key, bool isChecked)
    {
        if (isChecked) checkedCells.Add(key);
        else checkedCells.Remove(key);
    }

    private void TogglePaidCell((int OfferingId, int TrialId) key, bool isPaid)
    {
        if (isPaid) paidCells.Add(key);
        else paidCells.Remove(key);
    }

    private void SelectHandler(MSSA_Handler h)
    {
        selectedHandler = h;
        entry.HandlerId = h.HandlerId;
    }

    private void ClearHandlerSelection()
    {
        selectedHandler = null;
        entry.HandlerId = 0;
    }

    private void SelectDog(MSSA_Dog d)
    {
        selectedDog = d;
        entry.DogId = d.DogId;
    }

    private void ClearDogSelection()
    {
        selectedDog = null;
        entry.DogId = 0;
    }

    // Pre-fills a new dog's Owner Name from whichever Handler is already selected -
    // same dog/handler pairing is the common case, so this saves retyping it.
    private MSSA_Dog NewDogDefaults()
    {
        return new MSSA_Dog { IsActive = true, OwnerName = selectedHandler?.FullName };
    }

    private async Task SubmitEntries()
    {
        try
        {
            errorMessage = "";
            successMessage = "";

            if (selectedHandler == null || selectedDog == null || !checkedCells.Any())
            {
                errorMessage = "Select a Handler, a Dog, and at least one run.";
                return;
            }

            int created = 0;
            foreach (var (offeringId, trialId) in checkedCells)
            {
                var offering = offerings?.FirstOrDefault(o => o.OfferingId == offeringId);
                if (offering == null) continue;

                var newEntry = new MSSA_Entry
                {
                    TrialId = trialId,
                    HandlerId = selectedHandler.HandlerId,
                    DogId = selectedDog.DogId,
                    ClassId = offering.ClassId,
                    HandlerIsMSSAMember = false,
                    IsPaid = paidCells.Contains((offeringId, trialId))
                };

                await EntryService.AddEntryAsync(newEntry, ModuleState.ModuleId);
                created++;
            }

            successMessage = $"Added {created} {(created == 1 ? "entry" : "entries")} for {selectedDog.Name}.";

            // Keep the Handler selected - the same handler often has more than one dog
            // to enter, and re-picking them each time was the main complaint about this
            // form. "Change" is still right there if they need a different handler.
            selectedDog = null;
            checkedCells.Clear();
            paidCells.Clear();

            await LoadEventEntries();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error adding entries");
            errorMessage = "Error adding entries. Please try again.";
        }
    }

    private async Task LoadEventEntries()
    {
        if (selectedEventId == 0 || trials == null)
        {
            eventEntries = null;
            return;
        }

        eventEntries = new List<EntryListItem>();
        foreach (var trial in trials)
        {
            var trialEntries = await EntryService.GetTrialEntriesAsync(trial.TrialId, ModuleState.ModuleId);
            if (trialEntries != null) eventEntries.AddRange(trialEntries);
        }
    }


    // ============ EDIT MODE (unchanged) ============


    private async Task OnEventChanged()
    {
        if (selectedEventId > 0)
        {
            trials = await EventService.GetEventTrialsAsync(selectedEventId, ModuleState.ModuleId);
            entry.TrialId = 0;
        }
        else
        {
            trials = null;
            entry.TrialId = 0;
        }
    }

    private async Task SaveEntry()
    {
        try
        {
            errorMessage = "";

            // Validation
            if (entry.TrialId == 0)
            {
                errorMessage = "Please select a trial.";
                return;
            }

            if (entry.HandlerId == 0)
            {
                errorMessage = "Please select a handler.";
                return;
            }

            if (entry.DogId == 0)
            {
                errorMessage = "Please select a dog.";
                return;
            }

            if (entry.ClassId == 0)
            {
                errorMessage = "Please select a class.";
                return;
            }

            // Parse time strings
            if (!string.IsNullOrWhiteSpace(runTimeString))
            {
                if (TryParseTime(runTimeString, out TimeSpan runTime))
                {
                    entry.RunTime = runTime;
                }
                else
                {
                    errorMessage = "Invalid run time format. Use mm:ss";
                    return;
                }
            }

            if (!string.IsNullOrWhiteSpace(tieBreakerTimeString))
            {
                if (TryParseTime(tieBreakerTimeString, out TimeSpan tieBreakerTime))
                {
                    entry.TieBreakerTime = tieBreakerTime;
                }
                else
                {
                    errorMessage = "Invalid tie breaker time format. Use mm:ss";
                    return;
                }
            }

            await EntryService.UpdateEntryAsync(entry, ModuleState.ModuleId);
            await logger.LogInformation("Entry updated successfully");
            AddModuleMessage("Entry saved successfully", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error saving entry");
            errorMessage = "Error saving entry. Please try again.";
        }
    }

    private async Task DeleteEntry()
    {
        try
        {
            if (await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this entry?"))
            {
                await EntryService.DeleteEntryAsync(entryId, ModuleState.ModuleId);
                await logger.LogInformation("Entry deleted");
                NavigationManager.NavigateTo(NavigateUrl());
            }
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error deleting entry");
            errorMessage = "Error deleting entry. Please try again.";
        }
    }

    private bool TryParseTime(string timeString, out TimeSpan result)
    {
        result = TimeSpan.Zero;

        if (string.IsNullOrWhiteSpace(timeString))
            return false;

        var parts = timeString.Split(':');
        if (parts.Length != 2)
            return false;

        if (int.TryParse(parts[0], out int minutes) && int.TryParse(parts[1], out int seconds))
        {
            if (seconds >= 0 && seconds < 60)
            {
                result = new TimeSpan(0, minutes, seconds);
                return true;
            }
        }

        return false;
    }
}