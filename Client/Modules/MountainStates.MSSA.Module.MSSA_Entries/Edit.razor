    private async Task SubmitEntries()
    {
        try
        {
            errorMessage = "";
            successMessage = "";

            if (selectedHandler == null || selectedDog == null || !checkedCells.Any())
            {
                errorMessage = "Select a Handler, a Dog, and at least one run.";
                return;
            }

            int created = 0;
            foreach (var (offeringId, trialId) in checkedCells)
            {
                var offering = offerings?.FirstOrDefault(o => o.OfferingId == offeringId);
                if (offering == null) continue;

                var newEntry = new MSSA_Entry
                {
                    TrialId = trialId,
                    HandlerId = selectedHandler.HandlerId,
                    DogId = selectedDog.DogId,
                    ClassId = offering.ClassId,
                    HandlerIsMSSAMember = false
                };

                await EntryService.AddEntryAsync(newEntry, ModuleState.ModuleId);
                created++;
            }

            successMessage = $"Added {created} {(created == 1 ? "entry" : "entries")} for {selectedDog.Name}.";

            // Clear everything except the Event selection, ready for the next dog.
            selectedHandler = null;
            selectedDog = null;
            handlerSearchTerm = "";
            dogSearchTerm = "";
            handlerSearchResults = null;
            dogSearchResults = null;
            checkedCells.Clear();

            await LoadEventEntries();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error adding entries");
            errorMessage = "Error adding entries. Please try again.";
        }
    }

    private async Task LoadEventEntries()
    {
        if (selectedEventId == 0 || trials == null)
        {
            eventEntries = null;
            return;
        }

        eventEntries = new List<EntryListItem>();
        foreach (var trial in trials)
        {
            var trialEntries = await EntryService.GetTrialEntriesAsync(trial.TrialId, ModuleState.ModuleId);
            if (trialEntries != null) eventEntries.AddRange(trialEntries);
        }
    }

    private async Task ExportEntriesToExcel()
    {
        if (eventEntries == null || !eventEntries.Any()) return;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Trial,Trial Date,Stock,Level,Handler ID,Handler,Dog ID,Dog,Run Order,Placing,Points");

        var ordered = eventEntries
            .OrderBy(e => e.TrialDate)
            .ThenBy(e => e.TrialId)
            .ThenBy(e => classes?.FirstOrDefault(c => c.ClassName == e.ClassName && c.SubClassName == e.SubClassName)?.PrintOrder ?? 999)
            .ThenBy(e => e.HandlerName);

        foreach (var e in ordered)
        {
            var trialName = trials?.FirstOrDefault(t => t.TrialId == e.TrialId)?.TrialName ?? e.TrialDate.ToString("MM/dd/yyyy");

            sb.AppendLine(string.Join(",",
                CsvEscape(trialName),
                CsvEscape(e.TrialDate.ToString("MM/dd/yyyy")),
                CsvEscape(e.Stock),
                CsvEscape($"{e.ClassName} {e.SubClassName}"),
                CsvEscape(e.HandlerId.ToString()),
                CsvEscape(e.HandlerName),
                CsvEscape(e.DogId.ToString()),
                CsvEscape(e.DogName),
                CsvEscape(e.RunOrder?.ToString() ?? ""),
                CsvEscape(e.Placing?.ToString() ?? ""),
                CsvEscape(e.TrialPoints?.ToString() ?? "")));
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"Entries_Event{selectedEventId}_{DateTime.Now:yyyyMMdd}.csv";

        await JSRuntime.InvokeVoidAsync("mssaDownloadFile", fileName, "text/csv", base64);
    }

    private static string CsvEscape(string value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n'))
        {
            return "\"" + value.Replace("\"", "\"\"") + "\"";
        }
        return value;
    }

